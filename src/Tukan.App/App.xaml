<Application x:Class="Tukan.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Chomik;component/Themes/ChomikTheme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/BOBER;component/Themes/BoberTheme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/SKRYBEK;component/Themes/SkrybekTheme.xaml" />
                <ResourceDictionary Source="Themes/TukanTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
