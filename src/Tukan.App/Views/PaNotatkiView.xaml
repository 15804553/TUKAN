<UserControl x:Class="Tukan.App.Views.PaNotatkiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Nowa"
                        MinWidth="88"
                        Style="{StaticResource PrimaryButton}"
                        Click="OnNowaClick" />
                <Button x:Name="EdytujButton"
                        Content="Edytuj"
                        MinWidth="88"
                        Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButton}"
                        IsEnabled="False"
                        Click="OnEdytujClick" />
                <Button x:Name="UsunButton"
                        Content="Usuń"
                        MinWidth="88"
                        Margin="8,0,0,0"
                        Style="{StaticResource DangerButton}"
                        IsEnabled="False"
                        Click="OnUsunClick" />
            </StackPanel>

            <TextBlock Text="Data powstaje przy utworzeniu i zmienia się przy każdym zapisie."
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource MutedTextBrush}" />
        </DockPanel>

        <DataGrid x:Name="NotatkiGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  Background="{StaticResource SurfaceBrush}"
                  Foreground="{StaticResource ForegroundBrush}"
                  BorderBrush="{StaticResource BorderBrush}"
                  HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                  RowBackground="{StaticResource SurfaceBrush}"
                  AlternatingRowBackground="{StaticResource SurfaceVariantBrush}"
                  SelectionChanged="OnWyborZmieniony"
                  MouseDoubleClick="OnDwuklik">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource SurfaceVariantBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Padding" Value="8,8" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="4,6" />
                    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="#F5F0E1" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Data utworzenia lub edycji"
                                    Binding="{Binding DataWyswietlana}"
                                    Width="210"
                                    IsReadOnly="True" />
                <DataGridTextColumn Header="Nagłówek"
                                    Binding="{Binding Naglowek}"
                                    Width="240"
                                    IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Treść"
                                    Binding="{Binding Tresc}"
                                    Width="*"
                                    IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="MaxHeight" Value="72" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="ToolTip" Value="{Binding Tresc}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="2"
                   Margin="0,8,0,0"
                   FontSize="12"
                   Foreground="{StaticResource MutedTextBrush}" />
    </Grid>
</UserControl>
