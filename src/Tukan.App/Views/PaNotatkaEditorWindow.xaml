<Window x:Class="Tukan.App.Views.PaNotatkaEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:Tukan.App.Views.Chrome"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Notatka"
        Width="560"
        SizeToContent="Height"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <chrome:TukanTitleBar x:Name="TitleBar"
                              Title="Notatka"
                              ShowMinimizeButton="False"
                              ShowMaximizeButton="False" />

        <StackPanel Grid.Row="1" Margin="20">
            <TextBlock x:Name="DataInfoTextBlock"
                       Text="Data zostanie ustawiona automatycznie przy zapisie."
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />

            <TextBlock Text="Nagłówek"
                       Foreground="{StaticResource TextBrush}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <TextBox x:Name="NaglowekTextBox"
                     MaxLength="200"
                     Style="{StaticResource DarkTextBox}"
                     Margin="0,0,0,12" />

            <TextBlock Text="Treść"
                       Foreground="{StaticResource TextBrush}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <TextBox x:Name="TrescTextBox"
                     MinHeight="160"
                     MaxHeight="320"
                     MaxLength="8000"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Style="{StaticResource DarkTextBox}" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button Content="Anuluj"
                        MinWidth="96"
                        Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButton}"
                        IsCancel="True" />
                <Button Content="Zapisz"
                        MinWidth="96"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        Click="OnZapiszClick" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
