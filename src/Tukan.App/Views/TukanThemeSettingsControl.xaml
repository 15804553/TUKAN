<UserControl x:Class="Tukan.App.Views.TukanThemeSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="16" MaxWidth="560">
        <TextBlock Text="Motyw kolorystyczny aplikacji"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8" />
        <TextBlock TextWrapping="Wrap"
                   Foreground="{StaticResource MutedTextBrush}"
                   Margin="0,0,0,16"
                   Text="Jednolita paleta kolorów dla całej aplikacji TUKAN — panel boczny, personel, grafik i rozkazy." />

        <TextBlock Text="Wybierz motyw"
                   Margin="0,0,0,6"
                   Foreground="{StaticResource TextBrush}" />
        <ComboBox x:Name="ThemeComboBox"
                  DisplayMemberPath="DisplayName"
                  SelectedValuePath="Key"
                  SelectionChanged="OnThemeSelectionChanged"
                  Margin="0,0,0,8" />

        <TextBlock x:Name="ThemeDescriptionText"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource MutedTextBrush}"
                   Margin="0,0,0,16" />

        <TextBlock Text="Podgląd kolorów"
                   Margin="0,0,0,6"
                   Foreground="{StaticResource TextBrush}" />
        <UniformGrid x:Name="ThemePreviewPanel"
                     Columns="4"
                     Height="40"
                     Margin="0,0,0,16" />

        <Button x:Name="ApplyThemeButton"
                Content="Zastosuj motyw"
                Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Left"
                Click="OnApplyThemeClick" />

        <TextBlock Text="Zmiana motywu obowiązuje natychmiast w otwartych oknach. Po pełnym wylogowaniu i ponownym logowaniu wszystkie widoki odświeżą się jednolicie."
                   TextWrapping="Wrap"
                   Foreground="{StaticResource MutedTextBrush}"
                   FontSize="11"
                   Margin="0,12,0,0" />
    </StackPanel>
</UserControl>
