<UserControl x:Class="Tukan.App.Views.Chrome.TukanTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             Height="36">
    <Border Background="{StaticResource TukanSidebarBrush}"
            MouseLeftButtonDown="OnTitleBarMouseDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="TUKAN"
                       Margin="14,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TukanSidebarAccentBrush}"
                       FontWeight="Bold"
                       FontSize="13" />

            <TextBlock Grid.Column="1"
                       x:Name="TitleTextBlock"
                       Margin="10,0,12,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TukanSidebarTextBrush}"
                       FontWeight="SemiBold"
                       FontSize="13"
                       TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="MinimizeButton"
                        Content="—"
                        Style="{StaticResource TukanChromeIconButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="Minimalizuj"
                        Click="OnMinimizeClick" />
                <Button x:Name="MaximizeButton"
                        Content="▢"
                        Style="{StaticResource TukanChromeIconButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="Maksymalizuj"
                        Click="OnMaximizeClick" />
                <Button Content="✕"
                        Style="{StaticResource TukanChromeCloseButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnCloseClick" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
