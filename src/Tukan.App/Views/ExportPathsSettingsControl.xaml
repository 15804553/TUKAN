<UserControl x:Class="Tukan.App.Views.ExportPathsSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel MaxWidth="720">
            <TextBlock Text="Nazwa instalacji"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       Margin="0,0,0,8" />
            <TextBlock Text="Umowna, niepowtarzalna nazwa tego komputera (np. JRG4_PA). Zapis lokalny — niezależny od wspólnej bazy."
                       Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />
            <TextBox x:Name="InstallationNameTextBox"
                     MaxLength="40"
                     Margin="0,0,0,8" />
            <Button Content="Zapisz nazwę"
                    HorizontalAlignment="Left"
                    Padding="16,8"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,0,0,28"
                    Click="OnSaveInstallationNameClick" />

            <TextBlock Text="Kopia zapasowa bazy danych"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       Margin="0,0,0,8" />
            <TextBlock Text="Katalog, w którym zapisywane są pliki kopii zapasowej (.bck). Ustawienie wspólne dla całej jednostki. Puste pole oznacza katalog pliku bazy danych."
                       Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="BackupPathTextBox" />
                <Button Grid.Column="1"
                        Content="Przeglądaj…"
                        Margin="8,0,0,0"
                        Padding="12,6"
                        Click="OnBrowseBackupPathClick" />
            </Grid>

            <TextBlock Text="Retencja kopii zapasowych"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       Margin="0,0,0,6" />
            <TextBlock Text="Pliki .bck starsze niż wybrany okres są automatycznie usuwane po wykonaniu backupu."
                       Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />
            <ComboBox x:Name="BackupRetentionComboBox"
                      MinWidth="180"
                      HorizontalAlignment="Left"
                      Margin="0,0,0,28" />

            <TextBlock Text="Ścieżki eksportu"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       Margin="0,0,0,8" />
            <TextBlock Text="Katalogi, w których zapisywane są eksportowane dokumenty. Ścieżki są wspólne dla całej jednostki."
                       Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,20" />

            <TextBlock Text="Rozkazy dzienne"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       Margin="0,0,0,6" />
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="RozkazyPathTextBox" />
                <Button Grid.Column="1"
                        Content="Przeglądaj…"
                        Margin="8,0,0,0"
                        Padding="12,6"
                        Click="OnBrowseRozkazyClick" />
            </Grid>

            <TextBlock Text="Grafik służb"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       Margin="0,0,0,6" />
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="GrafikSluzbPathTextBox" />
                <Button Grid.Column="1"
                        Content="Przeglądaj…"
                        Margin="8,0,0,0"
                        Padding="12,6"
                        Click="OnBrowseGrafikSluzbClick" />
            </Grid>

            <TextBlock Text="Grafik nurkowy"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       Margin="0,0,0,6" />
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="GrafikNurkowyPathTextBox" />
                <Button Grid.Column="1"
                        Content="Przeglądaj…"
                        Margin="8,0,0,0"
                        Padding="12,6"
                        Click="OnBrowseGrafikNurkowyClick" />
            </Grid>

            <Button Content="Zapisz ustawienia"
                    HorizontalAlignment="Left"
                    Padding="16,8"
                    Style="{StaticResource PrimaryButton}"
                    Click="OnSaveClick" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
