    <Content Include="..\..\..\SKRYBEK\src\SKRYBEK.App\Themes\kolory-ui.json" CopyToOutputDirectory="PreserveNewest" Link="kolory-ui.json" />
    <Content Include="..\..\..\SKRYBEK\src\SKRYBEK.App\Themes\kolory-rol.json" CopyToOutputDirectory="PreserveNewest" Link="kolory-rol.json" />
    <Content Include="..\..\..\SKRYBEK\src\SKRYBEK.App\Themes\kolory-grafik.json" CopyToOutputDirectory="PreserveNewest" Link="kolory-grafik.json" />
