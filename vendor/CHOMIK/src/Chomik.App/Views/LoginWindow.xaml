<Window x:Class="Chomik.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:Chomik.App.Views.Chrome"
        xmlns:branding="clr-namespace:Chomik.App.Views.Branding"
        Title="Chomik — logowanie"
        Height="500"
        Width="440"
        WindowStartupLocation="CenterScreen">
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="#D5D8DC"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="4"
                              Opacity="0.35"
                              Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <chrome:ChomikTitleBar Title="Logowanie" />

            <Grid Grid.Row="1" Margin="28,24,28,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <branding:ChomikBrandHeader Grid.Row="0"
                                            LogoSize="80"
                                            LogoCornerRadius="18"
                                            Variant="Dark"
                                            LogoAlignment="Center"
                                            Subtitle="System ewidencji personelu PSP"
                                            SubtitleBrush="{StaticResource MutedTextBrush}"
                                            SubtitleFontSize="13"
                                            Margin="0,0,0,12" />

                <Border Grid.Row="1"
                        Background="{StaticResource CardBrush}"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="Użytkownik"
                                   Margin="0,0,0,6"
                                   Foreground="{StaticResource TextBrush}" />
                        <ComboBox x:Name="LoginComboBox"
                                  Style="{StaticResource ModernComboBox}"
                                  IsEditable="False"
                                  DisplayMemberPath="."
                                  SelectionChanged="OnLoginSelectionChanged"
                                  PreviewKeyDown="OnLoginComboPreviewKeyDown" />

                        <TextBlock Text="Hasło"
                                   Margin="0,16,0,6"
                                   Foreground="{StaticResource TextBrush}" />
                        <PasswordBox x:Name="PasswordBox"
                                     Padding="10,8"
                                     FontSize="14"
                                     KeyDown="OnPasswordKeyDown" />

                        <TextBlock x:Name="ErrorTextBlock"
                                   Margin="0,12,0,0"
                                   Foreground="#C0392B"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />

                        <Button Content="Zaloguj"
                                Margin="0,20,0,0"
                                Style="{StaticResource PrimaryButton}"
                                Click="OnLoginClick"
                                IsDefault="True" />
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="2"
                           Margin="0,16,0,0"
                           Text="PA — bez hasła. Pozostali użytkownicy wymagane hasło."
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}" />
            </Grid>
        </Grid>
    </Border>
</Window>
