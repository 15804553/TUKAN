<Window x:Class="Chomik.App.Views.PersonnelProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:Chomik.App.Views.Chrome"
        xmlns:conv="clr-namespace:Chomik.App.Converters"
        Width="520"
        MinWidth="480"
        MaxWidth="560"
        SizeToContent="Height"
        MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        Title="Chomik — profil funkcjonariusza"
        ShowInTaskbar="False">
    <Window.Resources>
        <conv:DateValidityBrushConverter x:Key="DateValidityBrushConverter" />

        <Style x:Key="ProfileSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,20,0,10" />
        </Style>

        <Style x:Key="ProfileDateBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="MinWidth" Value="104" />
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="#D5D8DC"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="4"
                              Opacity="0.35"
                              Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <chrome:ChomikTitleBar x:Name="TitleBar" Title="Profil funkcjonariusza" />

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="28,20,28,8">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="{Binding Stopien}"
                                   DockPanel.Dock="Left"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0" />
                        <TextBlock Text="{Binding PelneImieNazwisko}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Text="{Binding Stanowisko}"
                               Margin="0,6,0,0"
                               FontSize="15"
                               Foreground="{StaticResource TextBrush}" />

                    <TextBlock Text="{Binding NumerZmianyLabel}"
                               Margin="0,4,0,0"
                               FontSize="13"
                               Foreground="{StaticResource MutedTextBrush}" />

                    <TextBlock Text="Terminy"
                               Style="{StaticResource ProfileSectionTitle}" />

                    <ItemsControl ItemsSource="{Binding Terminy}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Etykieta}"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="14"
                                               TextWrapping="Wrap"
                                               Margin="0,0,12,0" />
                                    <Border Grid.Column="1"
                                            Style="{StaticResource ProfileDateBadge}"
                                            Background="{Binding Data, Converter={StaticResource DateValidityBrushConverter}}">
                                        <TextBlock Text="{Binding WyswietlanaData}"
                                                   HorizontalAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Uprawnienia"
                               Style="{StaticResource ProfileSectionTitle}" />

                    <ItemsControl ItemsSource="{Binding Uprawnienia}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBrush}"
                                        CornerRadius="8"
                                        Padding="14,12"
                                        Margin="0,0,0,8"
                                        BorderBrush="#E8E4F0"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Etykieta}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,8" />
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="Ważne do:"
                                                       DockPanel.Dock="Left"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="13"
                                                       Margin="0,0,10,0" />
                                            <Border Style="{StaticResource ProfileDateBadge}"
                                                    HorizontalAlignment="Left"
                                                    Background="{Binding WazneDo, Converter={StaticResource DateValidityBrushConverter}}">
                                                <TextBlock Text="{Binding WyswietlanaData}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}" />
                                            </Border>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="EmptyUprawnieniaTextBlock"
                               Text="Brak przypisanych uprawnień."
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="13"
                               Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2"
                        HorizontalAlignment="Center"
                        Margin="24,8,24,24">
                <Button Content="Zamknij"
                        MinWidth="120"
                        Style="{StaticResource PrimaryButton}"
                        Click="OnCloseClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
