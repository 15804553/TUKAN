<Window x:Class="Chomik.App.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:branding="clr-namespace:Chomik.App.Views.Branding"
        xmlns:chrome="clr-namespace:Chomik.App.Views.Chrome"
        Title="Chomik — system ewidencji personelu PSP"
        Height="900"
        Width="1800"
        MinHeight="600"
        MinWidth="1200"
        WindowStartupLocation="CenterScreen">
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="#D5D8DC"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="4"
                              Opacity="0.35"
                              Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <chrome:ChomikTitleBar x:Name="TitleBar"
                                    Title="Chomik — system ewidencji personelu PSP"
                                    ShowMinimizeButton="True"
                                    ShowMaximizeButton="True" />

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        MinWidth="132"
                        Background="{StaticResource SidebarBackgroundBrush}">
                    <DockPanel Margin="10,16,10,12">
                        <StackPanel DockPanel.Dock="Top">
                            <branding:ChomikLogoMark LogoSize="56"
                                                     Variant="Dark"
                                                     HorizontalAlignment="Center"
                                                     Margin="0,0,0,10" />
                            <TextBlock Text="Zalogowany jako:"
                                       Foreground="{StaticResource SidebarMutedBrush}"
                                       FontSize="11"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="UserLoginTextBlock"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="{StaticResource SidebarMutedBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Bottom"
                                    HorizontalAlignment="Center">
                            <Button Style="{StaticResource SidebarInfoButton}"
                                    Click="OnAboutClick" />
                            <Button Content="Wyloguj"
                                    HorizontalAlignment="Center"
                                    Margin="0,16,0,0"
                                    Style="{StaticResource SidebarButton}"
                                    Click="OnLogoutClick" />
                        </StackPanel>

                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <Button x:Name="GeneralViewButton"
                                    Content="Widok ogólny"
                                    Style="{StaticResource SidebarButton}"
                                    Click="OnGeneralViewClick" />
                            <Button x:Name="PersonnelEditButton"
                                    Content="Edycja personelu"
                                    Style="{StaticResource SidebarButton}"
                                    Click="OnPersonnelEditClick"
                                    Visibility="Collapsed" />
                            <Button x:Name="PasswordAdminButton"
                                    Content="Zarządzanie hasłami"
                                    Style="{StaticResource SidebarButton}"
                                    Click="OnPasswordAdminClick"
                                    Visibility="Collapsed" />
                            <Button x:Name="SettingsButton"
                                    Content="Ustawienia"
                                    Style="{StaticResource SidebarButton}"
                                    Click="OnSettingsClick"
                                    Visibility="Collapsed" />
                            <Button x:Name="CreatePersonnelListButton"
                                    Content="Utwórz listę osób"
                                    Style="{StaticResource SidebarButton}"
                                    Click="OnCreatePersonnelListClick"
                                    Visibility="Collapsed" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1" Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="ViewTitleTextBlock"
                               Text="Widok ogólny"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />

                    <ContentControl x:Name="MainContentHost" Grid.Row="1" Margin="0,16,0,0" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
