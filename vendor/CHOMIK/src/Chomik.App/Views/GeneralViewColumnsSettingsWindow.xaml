<Window x:Class="Chomik.App.Views.GeneralViewColumnsSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:Chomik.App.Views.Chrome"
        Width="480"
        MinWidth="440"
        MaxWidth="520"
        SizeToContent="Height"
        MaxHeight="640"
        WindowStartupLocation="CenterOwner"
        Title="Chomik — ustawienia widoku"
        ShowInTaskbar="False">
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="#D5D8DC"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="4"
                              Opacity="0.35"
                              Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <chrome:ChomikTitleBar Title="Kolumny widoku ogólnego" />

            <StackPanel Grid.Row="1" Margin="28,20,28,12">
                <TextBlock Text="Wybierz kolumny widoczne w tabeli widoku ogólnego."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="14"
                           Margin="0,0,0,8" />
                <TextBlock Text="Stopień oraz imię i nazwisko są zawsze widoczne."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           Margin="0,0,0,16" />

                <Border Background="{StaticResource CardBrush}"
                        CornerRadius="8"
                        Padding="16"
                        BorderBrush="#E8E4F0"
                        BorderThickness="1">
                    <ListBox x:Name="ColumnsListBox"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          FontSize="14"
                                          Foreground="{StaticResource TextBrush}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="24,0,24,24">
                <Button Content="Anuluj"
                        MinWidth="96"
                        Margin="0,0,12,0"
                        Style="{StaticResource SecondaryButton}"
                        Click="OnCancelClick" />
                <Button Content="Zapisz"
                        MinWidth="96"
                        Style="{StaticResource PrimaryButton}"
                        Click="OnSaveClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
