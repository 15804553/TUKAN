<UserControl x:Class="Chomik.App.Views.Controls.NazwaSlownikPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource CardBrush}"
            CornerRadius="8"
            Padding="20"
            Margin="0,0,0,16">
        <StackPanel>
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontWeight="SemiBold"
                       FontSize="16"
                       Margin="0,0,0,8" />
            <TextBlock Text="{Binding Description, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12"
                       Margin="0,0,0,16" />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Nowa nazwa" />
                    <TextBox x:Name="NowaNazwaTextBox" Style="{StaticResource ModernTextBox}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Dodaj"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource PrimaryButton}"
                        Click="OnAddClick" />
            </Grid>

            <TextBlock Text="Istniejące pozycje"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />
            <ListBox x:Name="ItemsListBox"
                     MinHeight="100"
                     MaxHeight="180"
                     DisplayMemberPath="Nazwa"
                     SelectionChanged="OnSelectionChanged" />

            <Border x:Name="EditPanel"
                    Margin="0,16,0,0"
                    Padding="12"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="6"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Edycja wybranej pozycji"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12" />
                    <TextBlock Text="Nazwa" />
                    <TextBox x:Name="EditNazwaTextBox"
                             Style="{StaticResource ModernTextBox}"
                             Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Zapisz zmiany"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,8,0"
                                Click="OnUpdateClick" />
                        <Button Content="Usuń"
                                Style="{StaticResource SecondaryButton}"
                                Click="OnDeleteClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
