<Window x:Class="Chomik.App.Views.Chrome.ChomikAboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:Chomik.App.Views.Chrome"
        xmlns:branding="clr-namespace:Chomik.App.Views.Branding"
        SizeToContent="WidthAndHeight"
        MinWidth="380"
        MaxWidth="440"
        WindowStartupLocation="CenterOwner"
        Title="O programie"
        ShowInTaskbar="False">
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="#D5D8DC"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="4"
                              Opacity="0.35"
                              Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <chrome:ChomikTitleBar Title="O programie" />

            <StackPanel Grid.Row="1" Margin="28,20,28,16">
                <branding:ChomikBrandHeader LogoSize="72"
                                            LogoCornerRadius="16"
                                            Variant="Dark"
                                            LogoAlignment="Center"
                                            Subtitle="System ewidencji personelu PSP"
                                            SubtitleTextAlignment="Center"
                                            SubtitleHorizontalAlignment="Center"
                                            SubtitleBrush="{StaticResource MutedTextBrush}"
                                            SubtitleFontSize="13"
                                            Margin="0,0,0,16" />
                <TextBlock x:Name="VersionTextBlock"
                           TextAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           Margin="0,0,0,12" />
                <TextBlock TextAlignment="Center"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="14"
                           LineHeight="22">
                    <Run FontWeight="SemiBold" Text="Autor:" />
                    <LineBreak />
                    <Run Text="st. ogn. Maciej Wnęk" />
                    <LineBreak />
                    <Run Text="KM PSP Kraków JRG4" />
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Row="2"
                        HorizontalAlignment="Center"
                        Margin="24,0,24,24">
                <Button Content="Zamknij"
                        MinWidth="96"
                        Style="{StaticResource PrimaryButton}"
                        Click="OnCloseClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
