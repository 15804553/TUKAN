<Window x:Class="Chomik.App.Views.Chrome.ChomikMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:Chomik.App.Views.Chrome"
        SizeToContent="WidthAndHeight"
        MinWidth="360"
        MaxWidth="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="#D5D8DC"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="4"
                              Opacity="0.35"
                              Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <chrome:ChomikTitleBar x:Name="TitleBar" Title="Chomik" />

            <TextBlock x:Name="MessageTextBlock"
                       Grid.Row="1"
                       Margin="24,20,24,20"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="14"
                       LineHeight="20" />

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="24,0,24,24">
                <Button x:Name="NoButton"
                        Content="Nie"
                        MinWidth="88"
                        Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButton}"
                        Visibility="Collapsed"
                        Click="OnNoClick" />
                <Button x:Name="YesButton"
                        Content="Tak"
                        MinWidth="88"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,8,0"
                        Visibility="Collapsed"
                        Click="OnYesClick" />
                <Button x:Name="OkButton"
                        Content="OK"
                        MinWidth="88"
                        Style="{StaticResource PrimaryButton}"
                        Click="OnOkClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
