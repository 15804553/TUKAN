<UserControl x:Class="Chomik.App.Views.Pages.GeneralPersonnelView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Chomik.App.Converters"
             xmlns:controls="clr-namespace:Chomik.App.Controls"
             xmlns:models="clr-namespace:Chomik.Core.Models;assembly=Chomik.Core"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <UserControl.Resources>
        <conv:DataGridCellContentWidthConverter x:Key="CellContentWidthConverter" PaddingSubtract="12" />
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:DateValidityBrushConverter x:Key="DateValidityBrushConverter" />
        <conv:DateValidityAlertBrushConverter x:Key="DateValidityAlertBrushConverter" />
        <conv:StazSeniorityBrushConverter x:Key="StazSeniorityBrushConverter" />

        <DataTemplate x:Key="UprawnieniaAlertCellTemplate">
            <TextBlock Text="⚠"
                       FontSize="16"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       ToolTip="{Binding UprawnieniaAlertTooltip}"
                       Foreground="{Binding UprawnieniaAlertSeverity, Converter={StaticResource DateValidityAlertBrushConverter}}"
                       Visibility="{Binding HasUprawnieniaAlert, Converter={StaticResource BoolToVisibilityConverter}}" />
        </DataTemplate>

        <Style x:Key="GeneralPersonnelDataGridCell" TargetType="DataGridCell" BasedOn="{StaticResource ChomikDataGridCell}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="4,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True"
                                ClipToBounds="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WrappedCenteredDataGridText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="2,2" />
            <Setter Property="MaxWidth">
                <Setter.Value>
                    <Binding RelativeSource="{RelativeSource AncestorType=DataGridCell}"
                             Path="ActualWidth"
                             Converter="{StaticResource CellContentWidthConverter}" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WrappedCenteredTextColumnStyle" TargetType="TextBlock" BasedOn="{StaticResource WrappedCenteredDataGridText}" />

        <Style x:Key="CompactDataGridText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
        </Style>

        <Style x:Key="CompactDataGridTextColumnStyle" TargetType="TextBlock" BasedOn="{StaticResource CompactDataGridText}" />

        <Style x:Key="GeneralViewTextColumnStyle" TargetType="TextBlock" BasedOn="{StaticResource CompactDataGridTextColumnStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanEditGeneralViewShift, ElementName=Root}" Value="True">
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="TextTrimming" Value="None" />
                    <Setter Property="ToolTip" Value="{x:Null}" />
                    <Setter Property="MaxWidth">
                        <Setter.Value>
                            <Binding RelativeSource="{RelativeSource AncestorType=DataGridCell}"
                                     Path="ActualWidth"
                                     Converter="{StaticResource CellContentWidthConverter}" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WstepienieColumnStyle" TargetType="TextBlock" BasedOn="{StaticResource GeneralViewTextColumnStyle}">
            <Setter Property="Padding" Value="4,4" />
            <Setter Property="Background" Value="{Binding StazLat, Converter={StaticResource StazSeniorityBrushConverter}}" />
            <Setter Property="ToolTip" Value="{Binding StazLat, StringFormat=Staż: {0} lat}" />
        </Style>

        <Style x:Key="GeneralPersonnelColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ChomikDataGridColumnHeader}" />

        <x:Array x:Key="ZmianaNumbers" Type="sys:Int32">
            <sys:Int32>1</sys:Int32>
            <sys:Int32>2</sys:Int32>
            <sys:Int32>3</sys:Int32>
        </x:Array>

        <DataTemplate x:Key="StopienDisplayCellTemplate">
            <TextBlock Text="{Binding Stopien}"
                       Style="{StaticResource CompactDataGridText}" />
        </DataTemplate>

        <DataTemplate x:Key="StopienEditCellTemplate">
            <ComboBox Style="{StaticResource DataGridEmbeddedComboBox}"
                      ItemsSource="{DynamicResource StopnieList}"
                      DisplayMemberPath="Nazwa"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding StopienId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      MinWidth="72"
                      SelectionChanged="OnStopienSelectionChanged" />
        </DataTemplate>

        <DataTemplate x:Key="StopienCellTemplate">
            <ContentControl Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{StaticResource StopienDisplayCellTemplate}" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding CanEditStopien}" Value="True" />
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="ContentTemplate" Value="{StaticResource StopienEditCellTemplate}" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </DataTemplate>

        <DataTemplate x:Key="ZmianaDisplayCellTemplate">
            <TextBlock Text="{Binding NumerZmiany}"
                       Style="{StaticResource CompactDataGridText}" />
        </DataTemplate>

        <DataTemplate x:Key="ZmianaEditCellTemplate">
            <ComboBox Style="{StaticResource DataGridEmbeddedComboBox}"
                      ItemsSource="{StaticResource ZmianaNumbers}"
                      SelectedItem="{Binding NumerZmiany, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Focusable="True"
                      IsHitTestVisible="True"
                      SelectionChanged="OnZmianaSelectionChanged" />
        </DataTemplate>

        <DataTemplate x:Key="ZmianaCellTemplate">
            <ContentControl Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{StaticResource ZmianaDisplayCellTemplate}" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding CanEditZmiana}" Value="True" />
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="ContentTemplate" Value="{StaticResource ZmianaEditCellTemplate}" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </DataTemplate>

        <Style x:Key="GeneralViewDatePickerTextBox" TargetType="DatePickerTextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Focusable="False" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GeneralViewDatePicker" TargetType="DatePicker">
            <Setter Property="controls:DatePickerPopupPlacement.FixPopup" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="IsEnabled" Value="{Binding CanEditGeneralViewDates, ElementName=Root}" />
            <Setter Property="CalendarStyle">
                <Setter.Value>
                    <Style TargetType="Calendar">
                        <Setter Property="Background" Value="{StaticResource CardBrush}" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    ClipToBounds="True"
                                    Padding="2,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <DatePickerTextBox x:Name="PART_TextBox"
                                                       Grid.Column="0"
                                                       Style="{StaticResource GeneralViewDatePickerTextBox}"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       HorizontalContentAlignment="Center"
                                                       VerticalContentAlignment="Center"
                                                       Focusable="{TemplateBinding Focusable}" />
                                    <Button x:Name="PART_Button"
                                            Grid.Column="1"
                                            Width="26"
                                            MinWidth="26"
                                            Height="26"
                                            Margin="0,0,2,0"
                                            Style="{StaticResource GhostIconButton}"
                                            Foreground="{TemplateBinding Foreground}"
                                            Focusable="False"
                                            FontSize="12"
                                            VerticalAlignment="Center"
                                            Content="📅" />
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="False"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=PART_Button}"
                                   StaysOpen="False"
                                   PopupAnimation="Fade"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="{StaticResource CardBrush}"
                                        BorderBrush="#D5D0E6"
                                        BorderThickness="1"
                                        Padding="4">
                                    <Calendar x:Name="PART_Calendar"
                                              Style="{TemplateBinding CalendarStyle}"
                                              SelectedDate="{Binding SelectedDate, RelativeSource={RelativeSource TemplatedParent}}"
                                              DisplayDate="{Binding DisplayDate, RelativeSource={RelativeSource TemplatedParent}}"
                                              FirstDayOfWeek="{Binding FirstDayOfWeek, RelativeSource={RelativeSource TemplatedParent}}"
                                              IsTodayHighlighted="{Binding IsTodayHighlighted, RelativeSource={RelativeSource TemplatedParent}}"
                                              DisplayDateStart="{Binding DisplayDateStart, RelativeSource={RelativeSource TemplatedParent}}"
                                              DisplayDateEnd="{Binding DisplayDateEnd, RelativeSource={RelativeSource TemplatedParent}}" />
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ReadOnlyBadaniaDateCellTemplate">
            <TextBlock Padding="4,4"
                       Text="{Binding BadaniaOkresoweDo, StringFormat=dd.MM.yyyy, TargetNullValue=—}"
                       Style="{StaticResource CompactDataGridText}"
                       Background="{Binding BadaniaOkresoweDo, Converter={StaticResource DateValidityBrushConverter}}" />
        </DataTemplate>

        <DataTemplate x:Key="BadaniaDateEditCellTemplate">
            <DatePicker Margin="4,4"
                        Style="{StaticResource GeneralViewDatePicker}"
                        Background="{Binding BadaniaOkresoweDo, Converter={StaticResource DateValidityBrushConverter}}"
                        SelectedDate="{Binding BadaniaOkresoweDo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SelectedDateChanged="OnBadaniaDateChanged" />
        </DataTemplate>

        <DataTemplate x:Key="BadaniaDateCellTemplate">
            <ContentControl Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{StaticResource ReadOnlyBadaniaDateCellTemplate}" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding CanEditGeneralViewDates, ElementName=Root}" Value="True" />
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="ContentTemplate" Value="{StaticResource BadaniaDateEditCellTemplate}" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </DataTemplate>

        <DataTemplate x:Key="ReadOnlyKomoraDateCellTemplate">
            <TextBlock Padding="4,4"
                       Text="{Binding KomoraDymowaDo, StringFormat=dd.MM.yyyy, TargetNullValue=—}"
                       Style="{StaticResource CompactDataGridText}"
                       Background="{Binding KomoraDymowaDo, Converter={StaticResource DateValidityBrushConverter}}" />
        </DataTemplate>

        <DataTemplate x:Key="KomoraDateEditCellTemplate">
            <DatePicker Margin="4,4"
                        Style="{StaticResource GeneralViewDatePicker}"
                        Background="{Binding KomoraDymowaDo, Converter={StaticResource DateValidityBrushConverter}}"
                        SelectedDate="{Binding KomoraDymowaDo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SelectedDateChanged="OnKomoraDateChanged" />
        </DataTemplate>

        <DataTemplate x:Key="KomoraDateCellTemplate">
            <ContentControl Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{StaticResource ReadOnlyKomoraDateCellTemplate}" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding CanEditGeneralViewDates, ElementName=Root}" Value="True" />
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="ContentTemplate" Value="{StaticResource KomoraDateEditCellTemplate}" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </DataTemplate>

        <DataTemplate x:Key="ReadOnlyKppDateCellTemplate">
            <TextBlock Padding="4,4"
                       Text="{Binding KppDo, StringFormat=dd.MM.yyyy, TargetNullValue=—}"
                       Style="{StaticResource CompactDataGridText}"
                       Background="{Binding KppDo, Converter={StaticResource DateValidityBrushConverter}}" />
        </DataTemplate>

        <DataTemplate x:Key="KppDateEditCellTemplate">
            <DatePicker Margin="4,4"
                        Style="{StaticResource GeneralViewDatePicker}"
                        Background="{Binding KppDo, Converter={StaticResource DateValidityBrushConverter}}"
                        SelectedDate="{Binding KppDo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SelectedDateChanged="OnKppDateChanged" />
        </DataTemplate>

        <DataTemplate x:Key="KppDateCellTemplate">
            <ContentControl Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{StaticResource ReadOnlyKppDateCellTemplate}" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding CanEditGeneralViewDates, ElementName=Root}" Value="True" />
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="ContentTemplate" Value="{StaticResource KppDateEditCellTemplate}" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </DataTemplate>

        <DataTemplate x:Key="ReadOnlySelectedPermissionDateCellTemplate">
            <TextBlock Padding="4,4"
                       Text="{Binding WybraneUprawnienieWazneDo, StringFormat=dd.MM.yyyy, TargetNullValue=—}"
                       Style="{StaticResource CompactDataGridText}"
                       Background="{Binding WybraneUprawnienieWazneDo, Converter={StaticResource DateValidityBrushConverter}}" />
        </DataTemplate>

        <DataTemplate x:Key="SelectedPermissionDateEditCellTemplate">
            <DatePicker Margin="4,4"
                        Style="{StaticResource GeneralViewDatePicker}"
                        Background="{Binding WybraneUprawnienieWazneDo, Converter={StaticResource DateValidityBrushConverter}}"
                        SelectedDate="{Binding WybraneUprawnienieWazneDo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SelectedDateChanged="OnSelectedPermissionDateChanged" />
        </DataTemplate>

        <DataTemplate x:Key="SelectedPermissionDateCellTemplate">
            <ContentControl Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{StaticResource ReadOnlySelectedPermissionDateCellTemplate}" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding CanEditGeneralViewDates, ElementName=Root}" Value="True" />
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="ContentTemplate" Value="{StaticResource SelectedPermissionDateEditCellTemplate}" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Margin="0,0,0,16"
                Background="{StaticResource CardBrush}"
                CornerRadius="8"
                Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Zmiana" Foreground="{StaticResource MutedTextBrush}" />
                    <ComboBox x:Name="ShiftFilterComboBox"
                              Style="{StaticResource ModernComboBox}"
                              SelectionChanged="OnFilterChanged" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Uprawnienie / kurs" Foreground="{StaticResource MutedTextBrush}" />
                    <ComboBox x:Name="PermissionFilterComboBox"
                              Style="{StaticResource ModernComboBox}"
                              SelectionChanged="OnFilterChanged" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="Szukaj osoby" Foreground="{StaticResource MutedTextBrush}" />
                    <Grid>
                        <TextBox x:Name="SearchTextBox"
                                 Style="{StaticResource ModernTextBox}"
                                 Padding="10,8,34,8"
                                 TextChanged="OnFilterTextChanged" />
                        <Button x:Name="ClearSearchButton"
                                Width="28"
                                Height="28"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0"
                                Visibility="Collapsed"
                                Style="{StaticResource GhostIconButton}"
                                ToolTip="Wyczyść wyszukiwanie"
                                Click="OnClearSearchClick"
                                Content="×"
                                FontSize="18"
                                FontWeight="Bold" />
                    </Grid>
                </StackPanel>

                <Button Grid.Column="3"
                        VerticalAlignment="Bottom"
                        Content="Odśwież"
                        Style="{StaticResource PrimaryButton}"
                        Click="OnRefreshClick" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="8">
            <DockPanel>
                <TextBlock x:Name="StatusTextBlock"
                           DockPanel.Dock="Top"
                           Margin="8"
                           Foreground="{StaticResource MutedTextBrush}" />
                <DataGrid x:Name="PersonnelDataGrid"
                          Style="{StaticResource ChomikDataGrid}"
                          CellStyle="{StaticResource GeneralPersonnelDataGridCell}"
                          ColumnHeaderStyle="{StaticResource GeneralPersonnelColumnHeader}"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          PreviewMouseDoubleClick="OnPersonnelGridPreviewMouseDoubleClick"
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          Background="Transparent"
                          CanUserAddRows="False"
                          CanUserResizeColumns="True"
                          GridLinesVisibility="Horizontal"
                          ScrollViewer.CanContentScroll="False"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="False"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          SelectionUnit="FullRow">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Height" Value="36" />
                            <Setter Property="MinHeight" Value="32" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanEditGeneralViewShift, ElementName=Root}" Value="True">
                                    <Setter Property="Height" Value="NaN" />
                                    <Setter Property="MinHeight" Value="36" />
                                </DataTrigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn x:Name="ZmianaColumn"
                                                Header="Zm."
                                                Width="52"
                                                MinWidth="48"
                                                CellTemplate="{StaticResource ZmianaCellTemplate}" />
                        <DataGridTemplateColumn x:Name="StopienColumn"
                                                Header="Stopień"
                                                Width="1*"
                                                MinWidth="88"
                                                CellTemplate="{StaticResource StopienCellTemplate}" />
                        <DataGridTextColumn x:Name="PelneImieNazwiskoColumn"
                                            Header="Imię i nazwisko"
                                            Binding="{Binding PelneImieNazwisko}"
                                            SortMemberPath="Nazwisko"
                                            Width="2*"
                                            MinWidth="140"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GeneralViewTextColumnStyle}" />
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn x:Name="UprawnieniaAlertColumn"
                                                Header="Uwaga"
                                                Width="44"
                                                MinWidth="40"
                                                CellTemplate="{StaticResource UprawnieniaAlertCellTemplate}" />
                        <DataGridTextColumn x:Name="StanowiskoColumn"
                                            Header="Stanowisko"
                                            Binding="{Binding Stanowisko}"
                                            Width="1.2*"
                                            MinWidth="96"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GeneralViewTextColumnStyle}" />
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn x:Name="TelefonColumn"
                                            Header="Telefon"
                                            Binding="{Binding Telefon}"
                                            Width="1*"
                                            MinWidth="100"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GeneralViewTextColumnStyle}" />
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn x:Name="WstepienieColumn"
                                            Header="Wstąpienie do sł."
                                            Binding="{Binding DataWstepieniaDoSluzby, StringFormat=dd.MM.yyyy}"
                                            Width="1*"
                                            MinWidth="96"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource WstepienieColumnStyle}" />
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn x:Name="BadaniaColumn"
                                                Header="Badania do"
                                                Width="1*"
                                                MinWidth="92"
                                                CellTemplate="{StaticResource BadaniaDateCellTemplate}" />
                        <DataGridTemplateColumn x:Name="KomoraColumn"
                                                Header="Komora do"
                                                Width="1*"
                                                MinWidth="92"
                                                CellTemplate="{StaticResource KomoraDateCellTemplate}" />
                        <DataGridTemplateColumn x:Name="KppColumn"
                                                Header="KPP do"
                                                Width="1*"
                                                MinWidth="92"
                                                CellTemplate="{StaticResource KppDateCellTemplate}" />
                        <DataGridTextColumn x:Name="UprawnieniaColumn"
                                            Header="Uprawnienia"
                                            Binding="{Binding UprawnieniaSkrot}"
                                            Width="2*"
                                            MinWidth="120"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GeneralViewTextColumnStyle}" />
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn x:Name="SelectedPermissionValidityColumn"
                                                Header="Ważne do"
                                                Width="1*"
                                                MinWidth="96"
                                                Visibility="Collapsed"
                                                CellTemplate="{StaticResource SelectedPermissionDateCellTemplate}" />
                        <DataGridTextColumn x:Name="DodatekColumn"
                                            Header="Dodatek"
                                            Binding="{Binding DodatekMotywacyjny}"
                                            Width="0.8*"
                                            MinWidth="72"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GeneralViewTextColumnStyle}" />
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn x:Name="AwansColumn"
                                            Header="Awans (stop.)"
                                            Binding="{Binding DataAwansuStopien}"
                                            Width="1*"
                                            MinWidth="88"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GeneralViewTextColumnStyle}" />
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn x:Name="OdznaczeniaColumn"
                                            Header="Odznaczenia"
                                            Binding="{Binding OdznaczeniaSkrot}"
                                            Width="1.5*"
                                            MinWidth="120"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GeneralViewTextColumnStyle}" />
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn x:Name="InneUwagiColumn"
                                            Header="Inne uwagi"
                                            Binding="{Binding InneUwagi}"
                                            Width="1.2*"
                                            MinWidth="100"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GeneralViewTextColumnStyle}" />
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
