<UserControl x:Class="Chomik.App.Views.Pages.PasswordManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="SubtitleTextBlock"
                   Foreground="{StaticResource MutedTextBrush}" />

        <Border Grid.Row="1" Margin="0,16,0,16" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="8">
            <ListBox x:Name="UsersListBox"
                     DisplayMemberPath="Login"
                     SelectionChanged="OnUserSelectionChanged" />
        </Border>

        <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="16">
            <StackPanel>
                <TextBlock Text="Nowe hasło" />
                <PasswordBox x:Name="NewPasswordBox" Margin="0,6,0,12" Padding="10,8" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Ustaw hasło"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,8,0"
                            Click="OnSetPasswordClick" />
                    <Button Content="Reset do domyślnego"
                            Style="{StaticResource SecondaryButton}"
                            Click="OnResetClick" />
                </StackPanel>
                <TextBlock x:Name="HintTextBlock"
                           Margin="0,12,0,0"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
