<UserControl x:Class="Chomik.App.Views.Branding.ChomikBrandHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:branding="clr-namespace:Chomik.App.Views.Branding"
             x:Name="HeaderRoot">
    <StackPanel>
        <branding:ChomikLogoMark LogoSize="{Binding LogoSize, ElementName=HeaderRoot}"
                                 CornerRadius="{Binding LogoCornerRadius, ElementName=HeaderRoot}"
                                 Variant="{Binding Variant, ElementName=HeaderRoot}"
                                 HorizontalAlignment="{Binding LogoAlignment, ElementName=HeaderRoot}" />
        <TextBlock Text="{Binding Subtitle, ElementName=HeaderRoot}"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   TextAlignment="{Binding SubtitleTextAlignment, ElementName=HeaderRoot}"
                   HorizontalAlignment="{Binding SubtitleHorizontalAlignment, ElementName=HeaderRoot}"
                   Foreground="{Binding SubtitleBrush, ElementName=HeaderRoot}"
                   FontSize="{Binding SubtitleFontSize, ElementName=HeaderRoot}"
                   Visibility="{Binding SubtitleVisibility, ElementName=HeaderRoot}" />
    </StackPanel>
</UserControl>
