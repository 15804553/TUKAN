<Window x:Class="BOBER.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:BOBER.App.Views.Chrome"
        Title="BOBER — logowanie"
        Icon="/Resources/bober.ico"
        Height="420"
        Width="380"
        WindowStartupLocation="CenterScreen">
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="5" Opacity="0.7" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <chrome:BoberTitleBar Title="BOBER — Logowanie"
                                    ShowMinimizeButton="False"
                                    ShowMaximizeButton="False" />

            <Grid Grid.Row="1" Margin="28,20,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo -->
                <Image Grid.Row="0"
                       Source="/Resources/bober_logo.png"
                       Height="90"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <!-- Formularz -->
                <Border Grid.Row="1"
                        Background="{StaticResource BackgroundBrush}"
                        CornerRadius="6"
                        Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="Zmiana" Style="{StaticResource FormLabel}" />
                        <ComboBox x:Name="LoginComboBox"
                                  Style="{StaticResource LoginComboBox}"
                                  IsEditable="False"
                                  SelectionChanged="OnLoginSelectionChanged"
                                  PreviewKeyDown="OnLoginComboPreviewKeyDown" />

                        <TextBlock Text="Hasło"
                                   Style="{StaticResource FormLabel}"
                                   Margin="0,14,0,4" />
                        <PasswordBox x:Name="PasswordBox"
                                     Style="{StaticResource DarkPasswordBox}"
                                     KeyDown="OnPasswordKeyDown" />

                        <TextBlock x:Name="ErrorTextBlock"
                                   Margin="0,10,0,0"
                                   Foreground="{StaticResource AlertBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Visibility="Collapsed" />

                        <Button Content="Zaloguj"
                                Margin="0,16,0,0"
                                Style="{StaticResource PrimaryButton}"
                                Click="OnLoginClick"
                                IsDefault="True" />
                    </StackPanel>
                </Border>

            </Grid>
        </Grid>
    </Border>
</Window>
