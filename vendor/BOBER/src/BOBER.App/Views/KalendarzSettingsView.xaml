<UserControl x:Class="BOBER.App.Views.KalendarzSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel MaxWidth="520">
            <TextBlock x:Name="ColorsHeaderTextBlock"
                       Text="KOLORY ZMIAN W KALENDARZU"
                       Style="{StaticResource SectionHeader}" />
            <TextBlock x:Name="ColorsDescriptionTextBlock"
                       Text="Domyślnie jak w grafiku nurkowym. Kolory obowiązują dla DCA oraz kont zmian 1–3."
                       Foreground="{StaticResource ForegroundMutedBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />

            <Border x:Name="ColorsBorder"
                    Background="{StaticResource BackgroundBrush}"
                    CornerRadius="6"
                    Padding="14,12"
                    Margin="0,0,0,16">
                <ItemsControl x:Name="KoloryItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Etykieta}"
                                           Foreground="{StaticResource ForegroundBrush}"
                                           VerticalAlignment="Center"
                                           FontSize="12" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding KolorHex, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DarkTextBox}"
                                         Margin="8,0,8,0" />
                                <Border Grid.Column="2"
                                        CornerRadius="4"
                                        Height="22"
                                        Cursor="Hand"
                                        ToolTip="Kliknij, aby wybrać kolor"
                                        MouseLeftButtonDown="OnColorPreviewClick">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding PreviewColor}" />
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock Text="AUTOMATYCZNE USUWANIE NOTATEK"
                       Style="{StaticResource SectionHeader}" />
            <TextBlock x:Name="AutoDeleteDescriptionTextBlock"
                       Foreground="{StaticResource ForegroundMutedBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />
            <ComboBox x:Name="AutoDeleteComboBox"
                      Width="220"
                      HorizontalAlignment="Left"
                      Margin="0,0,0,16"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Przywróć domyślne"
                        Style="{StaticResource SecondaryButton}"
                        Padding="12,6"
                        Margin="0,0,8,0"
                        x:Name="ResetDefaultsButton"
                        Click="OnResetDefaultsClick" />
                <Button Content="Zapisz"
                        Style="{StaticResource PrimaryButton}"
                        Padding="12,6"
                        Click="OnSaveClick" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
