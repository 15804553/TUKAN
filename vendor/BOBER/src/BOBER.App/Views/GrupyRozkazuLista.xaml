<UserControl x:Class="BOBER.App.Views.GrupyRozkazuLista"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             VerticalAlignment="Center"
             HorizontalAlignment="Stretch">
    <UserControl.Resources>
        <Style x:Key="OpcjaCheckBox" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnOpcjaPreviewMouseDown" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <ToggleButton x:Name="Przycisk"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Padding="0"
                      Cursor="Hand"
                      Focusable="False"
                      ToolTip="{Binding Grupy.Podsumowanie}"
                      PreviewMouseLeftButtonDown="OnPrzyciskPreviewMouseDown"
                      PreviewMouseLeftButtonUp="OnPrzyciskPreviewMouseUp">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Ramka"
                            Background="{StaticResource SurfaceVariantBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="6,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Grupy.Podsumowanie}"
                                       Foreground="{StaticResource ForegroundBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="12" />
                            <TextBlock Grid.Column="1"
                                       Text="▾"
                                       Foreground="{StaticResource ForegroundMutedBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="10" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ramka" Property="BorderBrush" Value="{StaticResource AccentLightBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Ramka" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>
        <Popup PlacementTarget="{Binding ElementName=Przycisk}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               DataContext="{Binding DataContext, ElementName=Root}"
               IsOpen="{Binding IsChecked, ElementName=Przycisk, Mode=TwoWay}">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="8,6"
                    MinWidth="{Binding ActualWidth, ElementName=Przycisk}">
                <StackPanel>
                    <CheckBox Content="Urlopy"
                              Tag="Urlopy"
                              Style="{StaticResource OpcjaCheckBox}"
                              IsChecked="{Binding Grupy.Urlopy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Content="Wolna służba"
                              Tag="Wolna"
                              Style="{StaticResource OpcjaCheckBox}"
                              IsChecked="{Binding Grupy.WolnaSluzba, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Content="Chorzy"
                              Tag="Chorzy"
                              Style="{StaticResource OpcjaCheckBox}"
                              IsChecked="{Binding Grupy.Chorzy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Content="Delegacje"
                              Tag="Delegacje"
                              Style="{StaticResource OpcjaCheckBox}"
                              IsChecked="{Binding Grupy.Delegacje, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Content="Dyżur domowy"
                              Tag="Dyzur"
                              Style="{StaticResource OpcjaCheckBox}"
                              IsChecked="{Binding Grupy.DyzurDomowy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
