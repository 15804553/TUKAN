<UserControl x:Class="BOBER.App.Views.BoberSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="BoberSettingsGroupBox" TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BoberSettingsSectionGroupBox" TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="{StaticResource SurfaceVariantBrush}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1,1,1,0"
                                    CornerRadius="6,6,0,0"
                                    Padding="10,6">
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <Border Grid.Row="1"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1,0,1,1"
                                    CornerRadius="0,0,6,6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BoberSettingsExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,4,0,12" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="IsExpanded" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="10,8">
                            <DockPanel>
                                <ToggleButton x:Name="HeaderSite"
                                              DockPanel.Dock="Top"
                                              Content="{TemplateBinding Header}"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              FontWeight="{TemplateBinding FontWeight}"
                                              FontSize="{TemplateBinding FontSize}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalContentAlignment="Left"
                                              Cursor="Hand"
                                              Padding="0,0,0,4">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="Arrow"
                                                               Text="▸"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0"
                                                               Foreground="{StaticResource ForegroundMutedBrush}" />
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="Text" Value="▾" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="ExpandSite"
                                                  DockPanel.Dock="Bottom"
                                                  Visibility="Collapsed"
                                                  Margin="0,8,0,0" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="KolorRoliRowTemplate">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Etykieta}"
                           Foreground="{StaticResource ForegroundBrush}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           TextWrapping="Wrap" />
                <TextBox Grid.Column="1"
                         Text="{Binding DisplayHex, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource DarkTextBox}"
                         Margin="8,0,4,0" />
                <Button Grid.Column="2"
                        Content="Brak"
                        Padding="8,2"
                        Margin="0,0,8,0"
                        FontSize="11"
                        Cursor="Hand"
                        ToolTip="Brak wypełnienia tła komórki"
                        Click="OnClearColorClick">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AllowEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Border Grid.Column="3"
                        CornerRadius="4"
                        Height="22"
                        Cursor="Hand"
                        ToolTip="Kliknij, aby wybrać kolor"
                        MouseLeftButtonDown="OnColorPreviewClick">
                    <Border.Background>
                        <SolidColorBrush Color="{Binding PreviewColor}" />
                    </Border.Background>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      Padding="0,0,4,0">
            <StackPanel x:Name="SectionsPanel" Margin="20,16,20,8">

                <StackPanel x:Name="ParametryZmianySection">
                <TextBlock x:Name="ParametryZmianyHeader"
                           Text="PARAMETRY ZMIANY"
                           Style="{StaticResource SectionHeader}" />
                <Border Background="{StaticResource BackgroundBrush}"
                        CornerRadius="6"
                        Padding="14,12"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="NazwaZmianyHeader"
                                   Grid.Column="2"
                                   Text="Twoja zmiana"
                                   Style="{StaticResource FormLabel}"
                                   HorizontalAlignment="Center"
                                   FontWeight="SemiBold" />

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="Stan zmiany (stanowiska)"
                                   Style="{StaticResource FormLabel}"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="StanZmianyTextBox"
                                 Grid.Row="1"
                                 Grid.Column="2"
                                 Style="{StaticResource DarkTextBox}"
                                 TextAlignment="Center" />

                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Text="Stan minimalny"
                                   Style="{StaticResource FormLabel}"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="StanMinimalnyTextBox"
                                 Grid.Row="3"
                                 Grid.Column="2"
                                 Style="{StaticResource DarkTextBox}"
                                 TextAlignment="Center" />

                        <TextBlock Grid.Row="5"
                                   Grid.Column="0"
                                   Text="Max ilość urlopów"
                                   Style="{StaticResource FormLabel}"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="MaxUrlopowNaSluzbieTextBox"
                                 Grid.Row="5"
                                 Grid.Column="2"
                                 Style="{StaticResource DarkTextBox}"
                                 TextAlignment="Center" />
                    </Grid>
                </Border>
                </StackPanel>

                <StackPanel x:Name="KolejnoscSection">
                <TextBlock x:Name="KolejnoscHeader"
                           Text="KOLEJNOŚĆ FUNKCJONARIUSZY"
                           Style="{StaticResource SectionHeader}" />
                <Border Background="{StaticResource BackgroundBrush}"
                        CornerRadius="6"
                        Padding="14,12"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="220" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.ColumnSpan="2"
                                   Text="Kolejność wyświetlania (zaznacz i użyj strzałek)"
                                   Style="{StaticResource FormLabel}"
                                   Margin="0,0,0,6" />

                        <StackPanel Grid.Row="1"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <Button Content="↑"
                                    Width="32"
                                    Height="28"
                                    Margin="0,4"
                                    ToolTip="Przesuń wyżej"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="0"
                                    Click="OnMoveUpClick" />
                            <Button Content="↓"
                                    Width="32"
                                    Height="28"
                                    Margin="0,4"
                                    ToolTip="Przesuń niżej"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="0"
                                    Click="OnMoveDownClick" />
                        </StackPanel>

                        <ListBox x:Name="FunkcjonariuszeListBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Background="{StaticResource SurfaceVariantBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 BorderThickness="1"
                                 Foreground="{StaticResource ForegroundBrush}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
                                    <Setter Property="Padding" Value="8,5" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Numer}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource ForegroundMutedBrush}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,0,6,0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ImieNazwisko}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
                </StackPanel>

                <StackPanel x:Name="KolorySection">
                <Expander x:Name="EksportGrafikuExpander"
                          Header="Exportowanie grafiku do excel"
                          Style="{StaticResource BoberSettingsExpander}">
                    <GroupBox Style="{StaticResource BoberSettingsGroupBox}">
                        <StackPanel>
                            <CheckBox x:Name="LessColorCheckBox"
                                      Content="LessColor — eksport grafiku bez kolorów ról (białe wiersze, czarna czcionka, żółte WS i D)"
                                      Foreground="{StaticResource ForegroundBrush}"
                                      IsChecked="True"
                                      Margin="0,0,0,12" />
                            <CheckBox x:Name="ExportAlternatingColorsCheckBox"
                                      Content="Kolorowanie naprzemienne w eksporcie Excel"
                                      Foreground="{StaticResource ForegroundBrush}"
                                      Checked="OnExportAlternatingColorsChanged"
                                      Unchecked="OnExportAlternatingColorsChanged"
                                      Margin="0,0,0,8" />
                            <StackPanel x:Name="ExportAlternatingColorsPanel"
                                        IsEnabled="False"
                                        Margin="0,0,0,12">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Kolor A (wiersze nieparzyste)"
                                               Foreground="{StaticResource ForegroundBrush}"
                                               VerticalAlignment="Center"
                                               FontSize="12" />
                                    <TextBox x:Name="ExportAltColorATextBox"
                                             Grid.Column="1"
                                             Style="{StaticResource DarkTextBox}"
                                             Margin="8,0,8,0"
                                             TextChanged="OnAltColorTextChanged" />
                                    <Border x:Name="ExportAltColorAPreview"
                                            Grid.Column="2"
                                            CornerRadius="4"
                                            Height="22"
                                            Cursor="Hand"
                                            ToolTip="Kliknij, aby wybrać kolor"
                                            MouseLeftButtonDown="OnAltColorPreviewClick"
                                            Tag="ExportA" />
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Kolor B (wiersze parzyste)"
                                               Foreground="{StaticResource ForegroundBrush}"
                                               VerticalAlignment="Center"
                                               FontSize="12" />
                                    <TextBox x:Name="ExportAltColorBTextBox"
                                             Grid.Column="1"
                                             Style="{StaticResource DarkTextBox}"
                                             Margin="8,0,8,0"
                                             TextChanged="OnAltColorTextChanged" />
                                    <Border x:Name="ExportAltColorBPreview"
                                            Grid.Column="2"
                                            CornerRadius="4"
                                            Height="22"
                                            Cursor="Hand"
                                            ToolTip="Kliknij, aby wybrać kolor"
                                            MouseLeftButtonDown="OnAltColorPreviewClick"
                                            Tag="ExportB" />
                                </Grid>
                            </StackPanel>
                            <ItemsControl x:Name="KoloryEksportuItemsControl"
                                          ItemTemplate="{StaticResource KolorRoliRowTemplate}" />
                        </StackPanel>
                    </GroupBox>
                </Expander>

                <Expander x:Name="KolorowanieGrafikowExpander"
                          Header="Kolorowanie grafików"
                          Style="{StaticResource BoberSettingsExpander}">
                    <StackPanel>
                        <GroupBox Style="{StaticResource BoberSettingsSectionGroupBox}">
                            <GroupBox.Header>
                                <RadioButton x:Name="RoleColorsRadio"
                                             Content="Kolorowanie wg stanowisk i uprawnień"
                                             GroupName="GrafikColorMode"
                                             FontWeight="SemiBold"
                                             Foreground="{StaticResource ForegroundBrush}"
                                             IsChecked="True"
                                             Checked="OnGrafikColorModeChanged" />
                            </GroupBox.Header>
                            <ItemsControl x:Name="KoloryItemsControl"
                                          ItemTemplate="{StaticResource KolorRoliRowTemplate}" />
                        </GroupBox>

                        <GroupBox Style="{StaticResource BoberSettingsSectionGroupBox}"
                                  Margin="0">
                            <GroupBox.Header>
                                <RadioButton x:Name="AlternatingColorsRadio"
                                             Content="Kolorowanie naprzemienne"
                                             GroupName="GrafikColorMode"
                                             FontWeight="SemiBold"
                                             Foreground="{StaticResource ForegroundBrush}"
                                             Checked="OnGrafikColorModeChanged" />
                            </GroupBox.Header>
                            <StackPanel x:Name="AlternatingColorsPanel"
                                        IsEnabled="False">
                                <TextBlock Text="Dwa kolory zamiast kolorów ról (tylko widok, nie eksport; WS bez zmian)."
                                           Foreground="{StaticResource ForegroundMutedBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8" />
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Kolor A (wiersze nieparzyste)"
                                               Foreground="{StaticResource ForegroundBrush}"
                                               VerticalAlignment="Center"
                                               FontSize="12" />
                                    <TextBox x:Name="AltColorATextBox"
                                             Grid.Column="1"
                                             Style="{StaticResource DarkTextBox}"
                                             Margin="8,0,8,0"
                                             TextChanged="OnAltColorTextChanged" />
                                    <Border x:Name="AltColorAPreview"
                                            Grid.Column="2"
                                            CornerRadius="4"
                                            Height="22"
                                            Cursor="Hand"
                                            ToolTip="Kliknij, aby wybrać kolor"
                                            MouseLeftButtonDown="OnAltColorPreviewClick"
                                            Tag="A" />
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Kolor B (wiersze parzyste)"
                                               Foreground="{StaticResource ForegroundBrush}"
                                               VerticalAlignment="Center"
                                               FontSize="12" />
                                    <TextBox x:Name="AltColorBTextBox"
                                             Grid.Column="1"
                                             Style="{StaticResource DarkTextBox}"
                                             Margin="8,0,8,0"
                                             TextChanged="OnAltColorTextChanged" />
                                    <Border x:Name="AltColorBPreview"
                                            Grid.Column="2"
                                            CornerRadius="4"
                                            Height="22"
                                            Cursor="Hand"
                                            ToolTip="Kliknij, aby wybrać kolor"
                                            MouseLeftButtonDown="OnAltColorPreviewClick"
                                            Tag="B" />
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </Expander>

                <Expander x:Name="KoloryZmianExpander"
                          Header="Kolory zmian"
                          Style="{StaticResource BoberSettingsExpander}">
                    <GroupBox Style="{StaticResource BoberSettingsGroupBox}">
                        <ItemsControl x:Name="KoloryZmianItemsControl"
                                      ItemTemplate="{StaticResource KolorRoliRowTemplate}" />
                    </GroupBox>
                </Expander>
                </StackPanel>

                <StackPanel x:Name="GrafikManagementSection">
                <TextBlock x:Name="GrafikManagementHeader"
                           Text="ZARZĄDZANIE GRAFIKIEM" Style="{StaticResource SectionHeader}" />
                <Border Background="{StaticResource BackgroundBrush}"
                        CornerRadius="6"
                        Padding="14,12"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Generowanie grafiku bazowego (pusta komórka = w pracy wg rotacji)"
                                   Style="{StaticResource FormLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button x:Name="GenerateScheduleBtn"
                                    Content="Przygotuj grafik bazowy na bieżący rok"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="12,8"
                                    Click="OnGenerateScheduleClick" />
                        </StackPanel>

                        <TextBlock Text="Czyszczenie wpisów"
                                   Style="{StaticResource FormLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Wyczyść I półrocze"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="12,8"
                                    Margin="0,0,8,0"
                                    Click="OnClearH1Click" />
                            <Button Content="Wyczyść II półrocze"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="12,8"
                                    Click="OnClearH2Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <Border x:Name="SaveBar"
                Grid.Row="1"
                Background="{StaticResource BackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="Anuluj"
                        Style="{StaticResource SecondaryButton}"
                        MinWidth="90"
                        Margin="0,0,8,0"
                        Click="OnCancelClick" />
                <Button Content="Zapisz"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="90"
                        Click="OnSaveClick" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
