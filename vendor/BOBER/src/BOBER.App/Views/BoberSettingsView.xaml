<UserControl x:Class="BOBER.App.Views.BoberSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      Padding="0,0,4,0">
            <StackPanel Margin="20,16,20,8">

                <TextBlock Text="PARAMETRY ZMIANY" Style="{StaticResource SectionHeader}" />
                <Border Background="{StaticResource BackgroundBrush}"
                        CornerRadius="6"
                        Padding="14,12"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="NazwaZmianyHeader"
                                   Grid.Column="2"
                                   Text="Twoja zmiana"
                                   Style="{StaticResource FormLabel}"
                                   HorizontalAlignment="Center"
                                   FontWeight="SemiBold" />

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="Stan zmiany (stanowiska)"
                                   Style="{StaticResource FormLabel}"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="StanZmianyTextBox"
                                 Grid.Row="1"
                                 Grid.Column="2"
                                 Style="{StaticResource DarkTextBox}"
                                 TextAlignment="Center" />

                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Text="Stan minimalny"
                                   Style="{StaticResource FormLabel}"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="StanMinimalnyTextBox"
                                 Grid.Row="3"
                                 Grid.Column="2"
                                 Style="{StaticResource DarkTextBox}"
                                 TextAlignment="Center" />

                        <TextBlock Grid.Row="5"
                                   Grid.Column="0"
                                   Text="Max ilość urlopów"
                                   Style="{StaticResource FormLabel}"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="MaxUrlopowNaSluzbieTextBox"
                                 Grid.Row="5"
                                 Grid.Column="2"
                                 Style="{StaticResource DarkTextBox}"
                                 TextAlignment="Center" />
                    </Grid>
                </Border>

                <TextBlock Text="KOLEJNOŚĆ FUNKCJONARIUSZY" Style="{StaticResource SectionHeader}" />
                <Border Background="{StaticResource BackgroundBrush}"
                        CornerRadius="6"
                        Padding="14,12"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="220" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.ColumnSpan="2"
                                   Text="Kolejność wyświetlania (zaznacz i użyj strzałek)"
                                   Style="{StaticResource FormLabel}"
                                   Margin="0,0,0,6" />

                        <StackPanel Grid.Row="1"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <Button Content="↑"
                                    Width="32"
                                    Height="28"
                                    Margin="0,4"
                                    ToolTip="Przesuń wyżej"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="0"
                                    Click="OnMoveUpClick" />
                            <Button Content="↓"
                                    Width="32"
                                    Height="28"
                                    Margin="0,4"
                                    ToolTip="Przesuń niżej"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="0"
                                    Click="OnMoveDownClick" />
                        </StackPanel>

                        <ListBox x:Name="FunkcjonariuszeListBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Background="{StaticResource SurfaceVariantBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 BorderThickness="1"
                                 Foreground="{StaticResource ForegroundBrush}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
                                    <Setter Property="Padding" Value="8,5" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Numer}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource ForegroundMutedBrush}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,0,6,0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ImieNazwisko}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <TextBlock Text="KOLORY RÓL / STANOWISK" Style="{StaticResource SectionHeader}" />
                <Border Background="{StaticResource BackgroundBrush}"
                        CornerRadius="6"
                        Padding="14,12"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <CheckBox x:Name="LessColorCheckBox"
                                  Content="LessColor — eksport grafiku bez kolorów ról (białe wiersze, czarna czcionka, żółte WS i D)"
                                  Foreground="{StaticResource ForegroundBrush}"
                                  IsChecked="True"
                                  Margin="0,0,0,12" />

                        <CheckBox x:Name="MultiSelectCheckBox"
                                  Content="Zaznaczanie wielu kratek w grafiku służb (Shift/Ctrl w jednym wierszu)"
                                  Foreground="{StaticResource ForegroundBrush}"
                                  IsChecked="True"
                                  Margin="0,0,0,12" />

                        <CheckBox x:Name="AlternatingColorsCheckBox"
                                  Content="Kolorowanie naprzemienne — dwa kolory zamiast kolorów ról (tylko widok, nie eksport; WS bez zmian)"
                                  Foreground="{StaticResource ForegroundBrush}"
                                  Checked="OnAlternatingColorsChanged"
                                  Unchecked="OnAlternatingColorsChanged"
                                  Margin="0,0,0,8" />

                        <StackPanel x:Name="AlternatingColorsPanel"
                                    IsEnabled="False"
                                    Margin="24,0,0,12">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Kolor A (wiersze nieparzyste)"
                                           Foreground="{StaticResource ForegroundBrush}"
                                           VerticalAlignment="Center"
                                           FontSize="12" />
                                <TextBox x:Name="AltColorATextBox"
                                         Grid.Column="1"
                                         Style="{StaticResource DarkTextBox}"
                                         Margin="8,0,8,0"
                                         TextChanged="OnAltColorTextChanged" />
                                <Border x:Name="AltColorAPreview"
                                        Grid.Column="2"
                                        CornerRadius="4"
                                        Height="22"
                                        Cursor="Hand"
                                        ToolTip="Kliknij, aby wybrać kolor"
                                        MouseLeftButtonDown="OnAltColorPreviewClick"
                                        Tag="A" />
                            </Grid>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Kolor B (wiersze parzyste)"
                                           Foreground="{StaticResource ForegroundBrush}"
                                           VerticalAlignment="Center"
                                           FontSize="12" />
                                <TextBox x:Name="AltColorBTextBox"
                                         Grid.Column="1"
                                         Style="{StaticResource DarkTextBox}"
                                         Margin="8,0,8,0"
                                         TextChanged="OnAltColorTextChanged" />
                                <Border x:Name="AltColorBPreview"
                                        Grid.Column="2"
                                        CornerRadius="4"
                                        Height="22"
                                        Cursor="Hand"
                                        ToolTip="Kliknij, aby wybrać kolor"
                                        MouseLeftButtonDown="OnAltColorPreviewClick"
                                        Tag="B" />
                            </Grid>
                        </StackPanel>

                        <ItemsControl x:Name="KoloryItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="280" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Etykieta}"
                                                   Foreground="{StaticResource ForegroundBrush}"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   TextWrapping="Wrap" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding DisplayHex, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource DarkTextBox}"
                                                 Margin="8,0,4,0" />
                                        <Button Grid.Column="2"
                                                Content="Brak"
                                                Padding="8,2"
                                                Margin="0,0,8,0"
                                                FontSize="11"
                                                Cursor="Hand"
                                                ToolTip="Brak wypełnienia tła komórki"
                                                Click="OnClearColorClick">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AllowEmpty}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Border Grid.Column="3"
                                                CornerRadius="4"
                                                Height="22"
                                                Cursor="Hand"
                                                ToolTip="Kliknij, aby wybrać kolor"
                                                MouseLeftButtonDown="OnColorPreviewClick">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding PreviewColor}" />
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="ZARZĄDZANIE GRAFIKIEM" Style="{StaticResource SectionHeader}" />
                <Border Background="{StaticResource BackgroundBrush}"
                        CornerRadius="6"
                        Padding="14,12"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Generowanie grafiku bazowego (pusta komórka = w pracy wg rotacji)"
                                   Style="{StaticResource FormLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button x:Name="GenerateScheduleBtn"
                                    Content="Przygotuj grafik bazowy na bieżący rok"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="12,8"
                                    Click="OnGenerateScheduleClick" />
                        </StackPanel>

                        <TextBlock Text="Czyszczenie wpisów"
                                   Style="{StaticResource FormLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Wyczyść I półrocze"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="12,8"
                                    Margin="0,0,8,0"
                                    Click="OnClearH1Click" />
                            <Button Content="Wyczyść II półrocze"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="12,8"
                                    Click="OnClearH2Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="{StaticResource BackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="Anuluj"
                        Style="{StaticResource SecondaryButton}"
                        MinWidth="90"
                        Margin="0,0,8,0"
                        Click="OnCancelClick" />
                <Button Content="Zapisz"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="90"
                        Click="OnSaveClick" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
