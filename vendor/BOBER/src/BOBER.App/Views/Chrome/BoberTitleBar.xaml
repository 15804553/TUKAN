<UserControl x:Class="BOBER.App.Views.Chrome.BoberTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="TitleBarRoot"
             Height="36">
    <Border Background="{StaticResource TitleBarBrush}"
            MouseLeftButtonDown="OnTitleBarMouseDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TitleTextBlock"
                       Grid.Column="0"
                       Margin="14,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TitleBarForegroundBrush}"
                       FontWeight="SemiBold"
                       FontSize="13"
                       TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="MinimizeButton"
                        Content="—"
                        Style="{StaticResource ChromeIconButton}"
                        ToolTip="Minimalizuj"
                        Click="OnMinimizeClick" />
                <Button x:Name="MaximizeButton"
                        Content="▢"
                        Style="{StaticResource ChromeIconButton}"
                        ToolTip="Maksymalizuj"
                        Click="OnMaximizeClick" />
                <Button Content="✕"
                        Style="{StaticResource ChromeCloseButton}"
                        Click="OnCloseClick" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
