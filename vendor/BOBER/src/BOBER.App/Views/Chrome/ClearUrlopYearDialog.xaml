<Window x:Class="BOBER.App.Views.Chrome.ClearUrlopYearDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plan urlopów — usuwanie danych"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}">
    <Border Padding="20" MinWidth="460">
        <StackPanel>
            <TextBlock Text="Uwaga — operacja nieodwracalna"
                       Foreground="{StaticResource ButtonCloseBrush}"
                       FontWeight="SemiBold"
                       FontSize="14"
                       Margin="0,0,0,10" />
            <TextBlock x:Name="MessageTextBlock"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource ForegroundBrush}"
                       FontSize="13"
                       Margin="0,0,0,8" />
            <TextBlock Text="Wszystkie zaplanowane urlopy (wypoczynkowe i dodatkowe) zostaną trwale usunięte z bazy. Tej operacji nie można cofnąć."
                       TextWrapping="Wrap"
                       Foreground="{StaticResource ForegroundMutedBrush}"
                       FontSize="12"
                       Margin="0,0,0,16" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Usuń plan roku"
                        Style="{StaticResource UrlopPlanDangerButton}"
                        Width="130"
                        Margin="0,0,8,0"
                        Click="OnYesClick" />
                <Button Content="Anuluj"
                        Style="{StaticResource UrlopPlanSecondaryButton}"
                        Width="90"
                        Click="OnNoClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
