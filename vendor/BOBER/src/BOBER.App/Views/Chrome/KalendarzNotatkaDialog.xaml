<Window x:Class="BOBER.App.Views.Chrome.KalendarzNotatkaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notatka kalendarza"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.6" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource TitleBarBrush}"
                    MouseLeftButtonDown="OnTitleBarMouseDown"
                    CornerRadius="8,8,0,0">
                <Grid Height="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TitleTextBlock"
                               Text="Notatka kalendarza"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TitleBarForegroundBrush}"
                               FontWeight="SemiBold"
                               FontSize="13" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="AcceptButton"
                                Content="✓"
                                Style="{StaticResource ChromeIconButton}"
                                ToolTip="Zapisz"
                                FontWeight="Bold"
                                Click="OnAcceptClick" />
                        <Button Content="✕"
                                Style="{StaticResource ChromeCloseButton}"
                                ToolTip="Zamknij"
                                Click="OnCancelClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Padding="16">
                <StackPanel>
                    <TextBlock x:Name="DateTextBlock"
                               Foreground="{StaticResource ForegroundMutedBrush}"
                               FontSize="12"
                               Margin="0,0,0,10" />

                    <TextBlock x:Name="TargetLabel"
                               Text="Dla:"
                               Foreground="{StaticResource ForegroundMutedBrush}"
                               FontSize="12"
                               Margin="0,0,0,4" />
                    <StackPanel x:Name="TargetPanel" Margin="0,0,0,10">
                        <RadioButton x:Name="ThisShiftRadio"
                                     Content="Wybrana zmiana"
                                     GroupName="Target"
                                     IsChecked="True"
                                     Foreground="{StaticResource ForegroundBrush}"
                                     Margin="0,0,0,4" />
                        <RadioButton x:Name="AllShiftsRadio"
                                     Content="Wszystkie zmiany"
                                     GroupName="Target"
                                     Foreground="{StaticResource ForegroundBrush}" />
                    </StackPanel>
                    <StackPanel x:Name="PrivateTargetsPanel" Margin="0,0,0,10" Visibility="Collapsed">
                        <CheckBox x:Name="Shift1CheckBox"
                                  Content="Zmiana I"
                                  Foreground="{StaticResource ForegroundBrush}"
                                  Margin="0,0,0,4" />
                        <CheckBox x:Name="Shift2CheckBox"
                                  Content="Zmiana II"
                                  Foreground="{StaticResource ForegroundBrush}"
                                  Margin="0,0,0,4" />
                        <CheckBox x:Name="Shift3CheckBox"
                                  Content="Zmiana III"
                                  Foreground="{StaticResource ForegroundBrush}" />
                    </StackPanel>

                    <TextBox x:Name="NoteTextBox"
                             MinHeight="110"
                             MaxHeight="220"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontSize="13"
                             Foreground="{StaticResource ForegroundBrush}"
                             Background="{StaticResource BackgroundBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"
                             Padding="8"
                             CaretBrush="{StaticResource ForegroundBrush}" />

                    <TextBlock x:Name="StatusTextBlock"
                               Foreground="{StaticResource ForegroundMutedBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"
                               Visibility="Collapsed" />

                    <StackPanel x:Name="ActionsPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,12,0,0">
                        <Button x:Name="DeleteButton"
                                Content="Usuń"
                                Style="{StaticResource DangerButton}"
                                Padding="12,6"
                                Margin="0,0,8,0"
                                Visibility="Collapsed"
                                Click="OnDeleteClick" />
                        <Button x:Name="ReplyButton"
                                Content="Odpowiedz"
                                Style="{StaticResource SecondaryButton}"
                                Padding="12,6"
                                Margin="0,0,8,0"
                                Visibility="Collapsed"
                                Click="OnReplyClick" />
                        <Button x:Name="MarkReadButton"
                                Content="Przeczytałem"
                                Style="{StaticResource PrimaryButton}"
                                Padding="12,6"
                                Visibility="Collapsed"
                                Click="OnMarkReadClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
