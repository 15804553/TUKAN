<Window x:Class="BOBER.App.Views.Chrome.KalendarzDzienDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notatki dnia"
        Width="680"
        Height="560"
        MinWidth="520"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Margin="16"
            Background="#FFFFFF"
            BorderBrush="#1E2A38"
            BorderThickness="2"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              ShadowDepth="8"
                              Opacity="0.55"
                              Color="#0D1520" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="#1E2A38"
                    CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="OnTitleBarMouseDown"
                    Cursor="SizeAll">
                <Grid Height="42">
                    <TextBlock x:Name="HeaderTextBlock"
                               Margin="16,0,48,0"
                               VerticalAlignment="Center"
                               Foreground="#F4F7F8"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <Button HorizontalAlignment="Right"
                            Content="✕"
                            Style="{StaticResource ChromeCloseButton}"
                            Foreground="#F4F7F8"
                            ToolTip="Zamknij"
                            Click="OnCloseClick" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="16,14,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Border Width="12" Height="12" Background="#2E7D32" CornerRadius="2" Margin="0,0,6,0" />
                    <TextBlock Text="Wysłane"
                               FontSize="12"
                               Foreground="#2C3E50"
                               Margin="0,0,16,0"
                               VerticalAlignment="Center" />
                    <Border Width="12" Height="12" Background="#1565C0" CornerRadius="2" Margin="0,0,6,0" />
                    <TextBlock Text="Odebrane"
                               FontSize="12"
                               Foreground="#2C3E50"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Border Grid.Row="1"
                        Background="#F7F9FA"
                        BorderBrush="#C5CED6"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="6">
                    <ListBox x:Name="EntriesListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectionMode="Extended"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="OnEntriesDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="SelectionBorder"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="2"
                                                    CornerRadius="6"
                                                    Padding="2">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#8AA0B4" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#E67E22" />
                                                    <Setter TargetName="SelectionBorder" Property="Background" Value="#FFF6EC" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8"
                                        CornerRadius="4"
                                        BorderThickness="4,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#90A4AE" />
                                            <Setter Property="Background" Value="#FFFFFF" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSent}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#2E7D32" />
                                                    <Setter Property="Background" Value="#E8F5E9" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsReceived}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#1565C0" />
                                                    <Setter Property="Background" Value="#E3F2FD" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Tytul}" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="Foreground" Value="#1E2A38" />
                                                    <Setter Property="FontSize" Value="13" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSent}" Value="True">
                                                            <Setter Property="Foreground" Value="#1B5E20" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsReceived}" Value="True">
                                                            <Setter Property="Foreground" Value="#0D47A1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Szczegoly}"
                                                   FontSize="12"
                                                   Margin="0,2,0,0"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                    <Setter Property="Foreground" Value="#3E5163" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="Foreground" Value="#1E2A38" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Background="#EEF2F4"
                    BorderBrush="#D5DDE3"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8"
                    Padding="16,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="AddPrivateButton"
                            Content="Nowa prywatna notatka"
                            Style="{StaticResource SecondaryButton}"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            Click="OnAddPrivateClick" />
                    <Button x:Name="OpenButton"
                            Content="Otwórz"
                            Style="{StaticResource SecondaryButton}"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            Click="OnOpenClick" />
                    <Button x:Name="DeleteSelectedButton"
                            Content="Usuń zaznaczone"
                            Style="{StaticResource DangerButton}"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            Click="OnDeleteSelectedClick" />
                    <Button Content="Zamknij"
                            Style="{StaticResource PrimaryButton}"
                            Padding="12,6"
                            Click="OnCloseClick" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
