<Window x:Class="BOBER.App.Views.Chrome.KalendarzDzienDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notatki dnia"
        Width="620"
        Height="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="HeaderTextBlock"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border Width="10" Height="10" Background="#2E7D32" CornerRadius="2" Margin="0,0,6,0" />
                <TextBlock Text="Wysłane"
                           FontSize="11"
                           Margin="0,0,14,0"
                           VerticalAlignment="Center" />
                <Border Width="10" Height="10" Background="#1565C0" CornerRadius="2" Margin="0,0,6,0" />
                <TextBlock Text="Odebrane"
                           FontSize="11"
                           VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <ListBox x:Name="EntriesListBox"
                 Grid.Row="1"
                 SelectionMode="Extended"
                 MouseDoubleClick="OnEntriesDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,2"
                            Padding="8,6"
                            CornerRadius="4"
                            BorderThickness="4,0,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="#9E9E9E" />
                                <Setter Property="Background" Value="#18000000" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSent}" Value="True">
                                        <Setter Property="BorderBrush" Value="#2E7D32" />
                                        <Setter Property="Background" Value="#182E7D32" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsReceived}" Value="True">
                                        <Setter Property="BorderBrush" Value="#1565C0" />
                                        <Setter Property="Background" Value="#181565C0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding Tytul}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Normal" />
                                        <Setter Property="Foreground" Value="#424242" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSent}" Value="True">
                                                <Setter Property="Foreground" Value="#1B5E20" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsReceived}" Value="True">
                                                <Setter Property="Foreground" Value="#0D47A1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Szczegoly}"
                                       FontSize="12"
                                       Opacity="0.9"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Normal" />
                                        <Setter Property="Foreground" Value="#616161" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSent}" Value="True">
                                                <Setter Property="Foreground" Value="#2E7D32" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsReceived}" Value="True">
                                                <Setter Property="Foreground" Value="#1565C0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="AddPrivateButton"
                    Content="Nowa prywatna notatka"
                    Style="{StaticResource SecondaryButton}"
                    Padding="12,6"
                    Margin="0,0,8,0"
                    Click="OnAddPrivateClick" />
            <Button x:Name="OpenButton"
                    Content="Otwórz"
                    Style="{StaticResource SecondaryButton}"
                    Padding="12,6"
                    Margin="0,0,8,0"
                    Click="OnOpenClick" />
            <Button x:Name="DeleteSelectedButton"
                    Content="Usuń zaznaczone"
                    Style="{StaticResource DangerButton}"
                    Padding="12,6"
                    Margin="0,0,8,0"
                    Click="OnDeleteSelectedClick" />
            <Button Content="Zamknij"
                    Style="{StaticResource PrimaryButton}"
                    Padding="12,6"
                    Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
