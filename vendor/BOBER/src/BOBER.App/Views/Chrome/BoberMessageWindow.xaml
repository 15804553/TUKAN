<Window x:Class="BOBER.App.Views.Chrome.BoberMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:BOBER.App.Views.Chrome"
        SizeToContent="WidthAndHeight"
        MinWidth="340"
        MaxWidth="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.6" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <chrome:BoberTitleBar x:Name="TitleBar"
                                    Title="BOBER"
                                    ShowMinimizeButton="False"
                                    ShowMaximizeButton="False" />

            <TextBlock x:Name="MessageTextBlock"
                       Grid.Row="1"
                       Margin="20,16,20,16"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource ForegroundBrush}"
                       FontSize="13"
                       LineHeight="20" />

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="20,0,20,20">
                <Button x:Name="NoButton"
                        Content="Nie"
                        MinWidth="80"
                        Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButton}"
                        Visibility="Collapsed"
                        Click="OnNoClick" />
                <Button x:Name="YesButton"
                        Content="Tak"
                        MinWidth="80"
                        Margin="0,0,8,0"
                        Style="{StaticResource PrimaryButton}"
                        Visibility="Collapsed"
                        Click="OnYesClick" />
                <Button x:Name="OkButton"
                        Content="OK"
                        MinWidth="80"
                        Style="{StaticResource PrimaryButton}"
                        Click="OnOkClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
