<UserControl x:Class="BOBER.App.Views.BoberGrafikView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ZmianaTextBlock"
                               Foreground="{StaticResource ForegroundMutedBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0" />
                    <TextBlock x:Name="RokTextBlock"
                               Foreground="{StaticResource ForegroundMutedBrush}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel x:Name="ToolbarActionsPanel"
                            Grid.Column="1"
                            Orientation="Horizontal">
                    <Button Content="Eksportuj wszystkie miesiące do Excel"
                            Style="{StaticResource SecondaryButton}"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            Click="OnExportYearClick" />
                    <Button x:Name="SettingsButton"
                            Content="Ustawienia"
                            Style="{StaticResource SecondaryButton}"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            Click="OnSettingsClick" />
                    <Button x:Name="LogoutButton"
                            Content="Wyloguj"
                            Style="{StaticResource SecondaryButton}"
                            Padding="12,6"
                            Click="OnLogoutClick" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="MonthTabControl"
                    Grid.Row="1"
                    Background="{StaticResource BackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0"
                    Margin="8,8,8,0"
                    SelectionChanged="OnMonthTabChanged">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem" BasedOn="{StaticResource BoberTabItem}" />
            </TabControl.ItemContainerStyle>
        </TabControl>

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,5,12,5">
            <TextBlock Foreground="{StaticResource ForegroundMutedBrush}"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Text="Skróty klawiszowe:  Spacja — w pracy  |  D — Dyżur  |  W — Wolna służba  |  U — Urlop  |  E — Delegacja" />
        </Border>
    </Grid>
</UserControl>
