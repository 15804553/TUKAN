<UserControl x:Class="SKRYBEK.App.Views.RozkazEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SKRYBEK.App.ViewModels"
             xmlns:ctrl="clr-namespace:SKRYBEK.App.Views.Controls">

    <Grid x:Name="EditorRootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="PersonelColumn" Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══ PANEL PERSONELU (lewy) — widoczność w ApplyAccountMode ═══ -->
        <Grid x:Name="PersonelPanelHost"
              Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="4" />
            </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource SurfaceVariantBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Tytuł panelu -->
                <StackPanel Grid.Row="0" Margin="10,10,10,6">
                    <TextBlock Text="DOSTĘPNY PERSONEL"
                               Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="{Binding PersonelInfo}"
                               FontSize="10"
                               Foreground="{StaticResource ForegroundMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,6" />
                    <Button Content="↻  Odśwież z grafiku"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding PrzeladujPersonelZGrafikuCommand}"
                            IsEnabled="{Binding CanPrzeladujPersonelZGrafiku}"
                            HorizontalAlignment="Stretch"
                            Padding="8,4"
                            FontSize="11"
                            ToolTip="Ponownie odczytuje dostępny personel z grafiku służb na wybrany dzień. Nie czyści wpisanych osób w polach rozkazu." />
                </StackPanel>

                <!-- Filtry -->
                <StackPanel Grid.Row="1" Margin="8,0,8,6">
                    <TextBlock Text="Filtruj wg uprawnień / kursów:"
                               Style="{StaticResource FormLabel}"
                               Margin="0,0,0,4" />
                    <Grid>
                        <ToggleButton x:Name="FiltryUprawnienToggle"
                                      IsChecked="{Binding CzyFiltryDropDownOtwarte, Mode=TwoWay}"
                                      HorizontalContentAlignment="Stretch"
                                      Cursor="Hand"
                                      Background="{StaticResource SurfaceBrush}"
                                      BorderBrush="{StaticResource BorderBrush}"
                                      BorderThickness="1"
                                      Padding="8,5"
                                      Height="30">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="toggleBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="3"
                                            Padding="{TemplateBinding Padding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="20" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding OpisFiltrowUprawnien}"
                                                       Foreground="{StaticResource ForegroundBrush}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Path Grid.Column="1"
                                                  Data="M 0 0 L 4 4 L 8 0"
                                                  Stroke="{StaticResource ForegroundMutedBrush}"
                                                  StrokeThickness="1.5"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="toggleBorder" Property="BorderBrush"
                                                    Value="{StaticResource ControlHoverBorderBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="toggleBorder" Property="BorderBrush"
                                                    Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Popup IsOpen="{Binding CzyFiltryDropDownOtwarte, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=FiltryUprawnienToggle}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Slide">
                            <Border Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    MinWidth="{Binding ActualWidth, ElementName=FiltryUprawnienToggle}"
                                    MaxHeight="260"
                                    Padding="6,6,6,8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" Color="#000000" />
                                </Border.Effect>
                                <DockPanel>
                                    <Button DockPanel.Dock="Bottom"
                                            Content="Wyczyść filtry"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding ResetujFiltrCommand}"
                                            HorizontalAlignment="Stretch"
                                            Padding="8,4"
                                            FontSize="11"
                                            Margin="0,8,0,0" />
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding FiltryUprawnien}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Nazwa}"
                                                              IsChecked="{Binding CzyWybrane, UpdateSourceTrigger=PropertyChanged}"
                                                              Focusable="False"
                                                              Margin="2,2,2,2"
                                                              Foreground="{StaticResource ForegroundBrush}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <!-- Lista personelu -->
                <ListBox Grid.Row="2"
                         x:Name="PersonelList"
                         ItemsSource="{Binding Przefiltrowane}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4,2"
                                    Padding="6,4"
                                    CornerRadius="3"
                                    BorderThickness="2"
                                    BorderBrush="{Binding Converter={StaticResource FunkcjonariuszNurekObramowanieConverter}}"
                                    Background="{Binding Converter={StaticResource FunkcjonariuszRoleTloConverter}}">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" FontSize="12"
                                               Foreground="{Binding Converter={StaticResource FunkcjonariuszRoleKolorConverter}}"
                                               Text="{Binding StopienINazwisko}" />
                                    <TextBlock FontSize="10"
                                               Opacity="0.85"
                                               Foreground="{Binding Converter={StaticResource FunkcjonariuszRoleKolorConverter}}"
                                               Text="{Binding Stanowisko}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                      Background="{StaticResource BorderBrush}" ResizeBehavior="PreviousAndNext" />
        </Grid>

        <!-- ═══ OBSZAR EDYTORA (prawy) ═══ -->
        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,4,0">
            <StackPanel Margin="16,12,16,16">

                <!-- Nagłówek rozkazu -->
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12,10"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="ROZKAZ DZIENNY NR "
                                       FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource ForegroundBrush}"
                                       VerticalAlignment="Center" />
                            <TextBox Text="{Binding NumerRozkazu, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBox}"
                                     Width="64" FontWeight="Bold" FontSize="16"
                                     Padding="6,4"
                                     IsReadOnly="{Binding IsReadOnly}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="/"
                                       FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource ForegroundBrush}"
                                       VerticalAlignment="Center" Margin="2,0" />
                            <TextBlock Text="{Binding RokNumeru}"
                                       FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource ForegroundBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <TextBlock Text="Na dzień:"
                                       Foreground="{StaticResource ForegroundBrush}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <DatePicker SelectedDate="{Binding DataDateTime, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding CzyZatwierdzony, Converter={StaticResource InverseBoolConverter}}"
                                        Style="{StaticResource DarkDatePicker}"
                                        Width="148"
                                        Height="34"
                                        ToolTip="Dzień służby — personel z grafiku na tę datę. Ustawia „Kraków, dn.” o 3 dni wstecz." />
                            <TextBlock Text="Kraków, dn.:"
                                       Foreground="{StaticResource ForegroundBrush}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="20,0,8,0" />
                            <DatePicker SelectedDate="{Binding DataWystawieniaDateTime, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding CzyZatwierdzony, Converter={StaticResource InverseBoolConverter}}"
                                        Style="{StaticResource DarkDatePicker}"
                                        Width="148"
                                        Height="34"
                                        ToolTip="Data wystawienia rozkazu — ustawia „Na dzień” o 3 dni do przodu (cykl zmian) i numer rozkazu." />
                        </StackPanel>

                        <!-- Przyciski akcji -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                            <!-- Akceptacja rozkazu (wymaganie 3) -->
                            <Border Background="#2E7D32" CornerRadius="4" Padding="10,5"
                                    Margin="0,0,8,0"
                                    Visibility="{Binding CzyZatwierdzony, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="✔  ZATWIERDZONY"
                                           FontWeight="Bold" FontSize="12"
                                           Foreground="White" />
                            </Border>
                            <Button x:Name="BtnZatwierdzRozkaz"
                                    Content="✔  Zatwierdź rozkaz"
                                    Style="{StaticResource PrimaryButton}"
                                    Background="#2E7D32"
                                    Command="{Binding AkceptujRozkazCommand}"
                                    Visibility="Collapsed"
                                    Margin="0,0,8,0" />
                            <Button x:Name="BtnOdblokujRozkaz"
                                    Content="🔓  Odblokuj"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding OdblokujRozkazCommand}"
                                    Visibility="Collapsed"
                                    Margin="0,0,8,0" />
                            <Button x:Name="BtnZapiszRozkaz"
                                    Content="💾  Zapisz"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ZapiszCommand}"
                                    IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBoolConverter}}" />
                        </StackPanel>
                        <Button Grid.Column="3"
                                Content="📄  Eksport Word"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding EksportujDoWordCommand}" />
                    </Grid>
                </Border>

                <!-- Status -->
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="12"
                           Margin="0,0,0,10"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}" />

                <!-- ── 1) SŁUŻBA ────────────────────────────────────────── -->
                <TextBlock Text="1)   SŁUŻBA"
                           Style="{StaticResource SectionHeader}"
                           Margin="0,0,0,6" />

                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,8"
                        Margin="0,0,0,12">
                    <ItemsControl ItemsSource="{Binding Sluzba}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PozycjaSluzbyViewModel}">
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding NazwaStanowiska, Mode=OneWay}"
                                               Foreground="{StaticResource ForegroundBrush}"
                                               VerticalAlignment="Center"
                                               FontSize="13" />
                                    <TextBlock Grid.Column="1"
                                               Text="-"
                                               Foreground="{StaticResource ForegroundMutedBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="2"
                                              IsEditable="True"
                                              Style="{StaticResource EditableDarkComboBox}"
                                              SelectedItem="{Binding WybranyItem, UpdateSourceTrigger=PropertyChanged}"
                                              Text="{Binding TekstOsoby, UpdateSourceTrigger=PropertyChanged}"
                                              ItemsSource="{Binding DostepneOsoby}"
                                              IsReadOnly="{Binding DataContext.IsReadOnly,
                                                           RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <ComboBox.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="10"
                                                                   FontStyle="Italic"
                                                                   Foreground="{StaticResource ForegroundMutedBrush}"
                                                                   Margin="4,2,4,1" />
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                            </GroupStyle>
                                        </ComboBox.GroupStyle>
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:OsobaComboBoxItem}">
                                                <TextBlock Text="{Binding StopienINazwisko}"
                                                           ToolTip="{Binding TooltipText}"
                                                           Foreground="{Binding KolorRoliForeground}"
                                                           FontWeight="{Binding CzySugerowana,
                                                               Converter={StaticResource BoolToFontWeightConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- ── 2) PODZIAŁ BOJOWY ─────────────────────────────────── -->
                <TextBlock Text="2)   PODZIAŁ BOJOWY"
                           Style="{StaticResource SectionHeader}"
                           Margin="0,0,0,6" />

                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,8"
                        Margin="0,0,0,12">
                    <ItemsControl ItemsSource="{Binding PodzialBojowy}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SamochodViewModel}">
                                <Border Margin="6,4"
                                        MinWidth="200"
                                        BorderBrush="{Binding CzyPodstawowy, Converter={StaticResource SamochodTypToBorderBrushConverter}}"
                                        BorderThickness="2"
                                        CornerRadius="4"
                                        Padding="8,6">
                                    <StackPanel>
                                        <!-- Nazwa pojazdu/grupy + wymagane kursy -->
                                        <Border Background="{StaticResource AccentBrush}"
                                                CornerRadius="3"
                                                Padding="6,3"
                                                Margin="0,0,0,6">
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Nazwa}"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           Foreground="White"
                                                           VerticalAlignment="Center" />
                                                <Border Grid.Column="1"
                                                        Background="#F7F9FA"
                                                        CornerRadius="8"
                                                        Padding="6,1"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Cursor="Help"
                                                        ToolTip="{Binding WymaganeKursyTooltip}"
                                                        Visibility="{Binding CzyPokazujIkoneWymagan, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="ⓘ"
                                                                   FontSize="12"
                                                                   FontWeight="Bold"
                                                                   Foreground="{Binding WymaganeKursyKolor}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding PoziomNurkowyTekst}"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="{Binding WymaganeKursyKolor}"
                                                                   Margin="4,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding CzyPokazujPoziomNurkowy, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <!-- Pozycje -->
                                        <ItemsControl ItemsSource="{Binding Pozycje}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:PozycjaSamochoduViewModel}">
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="38" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0"
                                                                    Orientation="Horizontal"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding NumerPozycji}"
                                                                       Foreground="{StaticResource ForegroundMutedBrush}"
                                                                       FontSize="12" />
                                                            <TextBlock Text="{Binding OznaczeniePozycji}"
                                                                       FontSize="12"
                                                                       FontWeight="Bold"
                                                                       Margin="5,0,0,0"
                                                                       Foreground="{Binding OznaczenieBrush}"
                                                                       Visibility="{Binding MaOznaczenie, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        </StackPanel>
                                                        <ComboBox Grid.Column="1"
                                                                  IsEditable="True"
                                                                  Style="{StaticResource EditableDarkComboBox}"
                                                                  SelectedItem="{Binding WybranyItem, UpdateSourceTrigger=PropertyChanged}"
                                                                  Text="{Binding TekstOsoby, UpdateSourceTrigger=PropertyChanged}"
                                                                  ItemsSource="{Binding DostepneOsoby}"
                                                                  IsReadOnly="{Binding DataContext.IsReadOnly,
                                                                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  FontSize="11">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type vm:OsobaComboBoxItem}">
                                                                    <TextBlock Text="{Binding StopienINazwisko}"
                                                                               ToolTip="{Binding TooltipText}"
                                                                               Foreground="{Binding KolorRoliForeground}"
                                                                               FontWeight="{Binding CzySugerowana,
                                                                                   Converter={StaticResource BoolToFontWeightConverter}}" />
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- ── DYŻURNI RATOWNICY MEDYCZNI PSP ───────────────────── -->
                <TextBlock Text="DYŻURNI RATOWNICY MEDYCZNI PSP"
                           Style="{StaticResource SectionHeader}"
                           Margin="0,0,0,6" />

                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,8"
                        Margin="0,0,0,12">
                    <ItemsControl ItemsSource="{Binding RatownicyMedyczni}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RatownikMedycznyViewModel}">
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Pozycja, StringFormat={}{0}.}"
                                               Foreground="{StaticResource ForegroundBrush}"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="2"
                                              Width="180"
                                              HorizontalAlignment="Left"
                                              IsEditable="True"
                                              Style="{StaticResource EditableDarkComboBox}"
                                              SelectedItem="{Binding WybranyItem, UpdateSourceTrigger=PropertyChanged}"
                                              Text="{Binding TekstOsoby, UpdateSourceTrigger=PropertyChanged}"
                                              ItemsSource="{Binding DostepneOsoby}"
                                              IsReadOnly="{Binding DataContext.IsReadOnly,
                                                           RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <ComboBox.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="10"
                                                                   FontStyle="Italic"
                                                                   Foreground="{StaticResource ForegroundMutedBrush}"
                                                                   Margin="4,2,4,1" />
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                            </GroupStyle>
                                        </ComboBox.GroupStyle>
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:OsobaComboBoxItem}">
                                                <TextBlock Text="{Binding StopienINazwisko}"
                                                           ToolTip="{Binding TooltipText}"
                                                           Foreground="{Binding KolorRoliForeground}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- ── 3) ZAJĘCIA ──────────────────────────────────────── -->
                <TextBlock Text="3)   ZAJĘCIA"
                           Style="{StaticResource SectionHeader}"
                           Margin="0,0,0,6" />
                <TextBox Style="{StaticResource DarkSpellCheckTextBox}"
                         Text="{Binding Zajecia, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding IsReadOnly}"
                         TextWrapping="Wrap"
                         MinHeight="50"
                         Margin="0,0,0,12"
                         AcceptsReturn="True" />

                <!-- ── 4) NIEOBECNI W SŁUŻBIE ───────────────────────────── -->
                <TextBlock Text="4)   NIEOBECNI W SŁUŻBIE"
                           Style="{StaticResource SectionHeader}"
                           Margin="0,0,0,6" />

                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,8"
                        Margin="0,0,0,12">
                    <ItemsControl ItemsSource="{Binding NieobecniGrupy}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NieobecniGroupViewModel}">
                                <Border Margin="4" MinWidth="180"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Tytul}"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   Margin="0,0,0,4" />
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:NieobecnyViewModel}">
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ctrl:OsobaSuggestBox Grid.Column="0"
                                                                              Text="{Binding Nazwisko, UpdateSourceTrigger=PropertyChanged}"
                                                                              Personel="{Binding DataContext.WszystkieOsoby,
                                                                                           RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                              IsReadOnly="{Binding DataContext.IsReadOnly,
                                                                                           RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                              FontSize="12" />
                                                        <Button Grid.Column="1"
                                                                Content="✕"
                                                                Style="{StaticResource ChromeIconButton}"
                                                                Width="22" Height="22" FontSize="10"
                                                                Margin="4,0,0,0"
                                                                VerticalAlignment="Center"
                                                                ToolTip="Usuń osobę"
                                                                Foreground="{StaticResource ForegroundBrush}"
                                                                IsEnabled="{Binding DataContext.IsReadOnly,
                                                                           RelativeSource={RelativeSource AncestorType=UserControl},
                                                                           Converter={StaticResource InverseBoolConverter}}"
                                                                Tag="{Binding}"
                                                                Click="UsunNieobecnego_Click" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="＋ Dodaj"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DodajNieobecnegoCommand}"
                                                IsEnabled="{Binding DataContext.IsReadOnly,
                                                           RelativeSource={RelativeSource AncestorType=UserControl},
                                                           Converter={StaticResource InverseBoolConverter}}"
                                                HorizontalAlignment="Left"
                                                Padding="6,2"
                                                FontSize="11"
                                                Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- ── 5) UWAGI ──────────────────────────────────────────── -->
                <TextBlock Text="5)   UWAGI"
                           Style="{StaticResource SectionHeader}"
                           Margin="0,0,0,6" />
                <TextBox Style="{StaticResource DarkSpellCheckTextBox}"
                         Text="{Binding Uwagi, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding IsReadOnly}"
                         TextWrapping="Wrap"
                         MinHeight="60"
                         Margin="0,0,0,16"
                         AcceptsReturn="True" />

                <!-- Stopka -->
                <StackPanel HorizontalAlignment="Left" Margin="0,8,0,0">
                    <TextBlock Foreground="{StaticResource ForegroundMutedBrush}"
                               FontSize="11">
                        <Run Text="Rozkaz podpisał D-ca JRG-" />
                        <Run Text="{Binding NrJrg}" FontWeight="Bold" />
                    </TextBlock>
                    <TextBlock Text="................................"
                               Foreground="{StaticResource ForegroundMutedBrush}"
                               FontSize="11"
                               Margin="0,16,0,0" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
